height="52" as="geometry"/></mxCell><mxCell id="v99" value="файл настроек / environment" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="1158" width="256" height="52" as="geometry"/></mxCell><mxCell id="v100" value="🔒 SMTP: STARTTLS, пароль только по TLS · webhook: Bearer · не хранятся в БД" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="1158" width="556" height="52" as="geometry"/></mxCell><mxCell id="v101" value="root хоста, процесс службы" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="1158" width="286" height="52" as="geometry"/></mxCell><mxCell id="v102" value="⚠ лежат в конфигурации открытым текстом — права 0600 на файл, не прикладывать к обращениям" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="1158" width="436" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p13" name="13. СУБД, этап 1: согласованность приложения"><mxGraphModel dx="1880" dy="1636" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1636" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" value="Схема" parent="0"/><mxCell id="sec" value="Защита" parent="0"/><mxCell id="v1" value="13. Бэкап СУБД, этап 1 (реализовано): application-consistent копия ВМ через хуки заморозки" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1820" height="34" as="geometry"/></mxCell><mxCell id="v2" value="Копия диска остаётся прежней, меняется момент её снятия: перед заморозкой ФС агент вызывает сценарии, которые переводят СУБД в согласованное состояние. Фиолетовым — то, что добавил этап 1." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1820" height="40" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Что защищает шаг&lt;/b&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="118" width="380" height="40" as="geometry"/></mxCell><mxCell id="v57" value="&lt;b&gt;Служба&lt;/b&gt;&lt;br&gt;драйвер oVirt / kvm" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="200" height="58" as="geometry"/></mxCell><mxCell id="a58" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="168" as="sourcePoint"/><mxPoint x="130" y="1176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v59" value="&lt;b&gt;Движок oVirt / libvirt&lt;/b&gt;&lt;br&gt;freeze / thaw" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="200" height="58" as="geometry"/></mxCell><mxCell id="a60" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" pare