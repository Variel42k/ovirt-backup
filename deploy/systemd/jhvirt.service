[Unit]
Description=ovirt-backup
Documentation=file:@PREFIX@/docs/DEPLOY.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=@USER_NAME@
Group=@USER_NAME@
WorkingDirectory=@PREFIX@
ExecStart=@PREFIX@/bin/ovirt-backup-server -config @PREFIX@/config/ovirt-backup.yaml
Restart=on-failure
RestartSec=5s

# Секреты (пароль СУБД) — из файла с правами 0600, а не в юните: юнит читают все.
EnvironmentFile=@PREFIX@/config/jhvirt.env

# Сервису нужны только свои каталоги. Если локальное хранилище копий или
# каталог восстановления лежат вне @PREFIX@, добавьте их пути в
# ReadWritePaths — иначе запись отклонит ядро, а причина в сообщении об ошибке
# видна не сразу.
#
# Каталог восстановления при этом надо разрешить дважды: здесь — службе,
# и в backup.restore_dirs — оператору. Списки закрывают разное, и каталог,
# прописанный только в одном, работать не будет.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@READ_WRITE_PATHS@

# Ограничения ниже отбирают то, чем служба не пользуется. Смысл тот же, что и
# у read_only в compose: взлом процесса не должен превращаться во взлом хоста.
#
# Проверено по коду, а не выбрано по списку из статьи:
#   PrivateDevices     — устройства не нужны. NBD здесь сетевой клиент, а не
#                        /dev/nbd, и обращения к /dev в коде выполняются по SSH
#                        на удалённых хостах, а не тут.
#   CapabilityBoundingSet= — привилегий не нужно ни одной: служба работает от
#                        своего пользователя и слушает порт выше 1024.
#   RestrictAddressFamilies — сеть, unix-сокет к PostgreSQL и netlink, которым
#                        пользуется сам runtime Go при разрешении имён.
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# Восстановление и проверка держат много открытых объектов хранилища.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
