="1" parent="1"><mxGeometry x="510" y="878" width="556" height="52" as="geometry"/></mxCell><mxCell id="v76" value="служба через хелпер; администратор СУБД" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="878" width="286" height="52" as="geometry"/></mxCell><mxCell id="v77" value="⚠ роль читает все данные базы — при компрометации удалить ключ из authorized_keys jhvirt_dump" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="878" width="436" height="52" as="geometry"/></mxCell><mxCell id="v78" value="&lt;b&gt;KVM-хосты&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=12;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="934" width="226" height="52" as="geometry"/></mxCell><mxCell id="v79" value="libvirt через SSH" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="934" width="256" height="52" as="geometry"/></mxCell><mxCell id="v80" value="🔒 вход по ключу · host key обязателен · команды — только служебные (scratch, qemu-img, приём образа)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="934" width="556" height="52" as="geometry"/></mxCell><mxCell id="v81" value="служба" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetic