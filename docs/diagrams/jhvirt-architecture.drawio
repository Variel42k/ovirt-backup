olor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitY=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v41" target="v42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitY=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v41" target="v43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitY=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v41" target="v44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e72" value="строится на" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=open;dashed=1;strokeColor=#78909c;fontSize=10;fontColor=#546e7a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v43" target="v42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v73" value="&lt;i&gt;↓ backup / kvm / proxmox используют инфраструктурные пакеты&lt;/i&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="640" width="820" height="26" as="geometry"/></mxCell><mxCell id="v74" value="Во время работы" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1390" y="110" width="470" height="1100" as="geometry"/></mxCell><mxCell id="v75" value="&lt;b&gt;Периодические задачи&lt;/b&gt;&lt;br&gt;• задания ВМ, Engine, файлов — cron из БД&lt;br&gt;• work units бэкапа — по priority, с арендой&lt;br&gt;• репликация, уведомления — постоянно&lt;br&gt;• ретенция, удаление просроченного — 1 ч&lt;br&gt;• проверка хранилищ — 15 мин&lt;br&gt;• поиск устаревших копий — 1 ч · очистка истории — 6 ч&lt;br&gt;• опрос состояния и метрик — 30 с" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1410" y="150" width="430" height="170" as="geometry"/></mxCell><mxCell id="v76" value="&lt;b&gt;Ограничители параллельности&lt;/b&gt;&lt;br&gt;• backup.workers — бэкапы (упираются в гипервизор)&lt;br&gt;• backup.heavy_workers — проверки и восстановления&lt;br&gt;• transfer.max_parallel_disks — диски одной ВМ&lt;br&gt;• concurrency задания поверх общего лимита&lt;br&gt;• FOR UPDATE SKIP LOCKED + аренда с heartbeat" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1410" y="340" width="430" height="130" as="geometry"/></mxCell><mxCell id="v77" value="&lt;b&gt;PostgreSQL&lt;/b&gt; — задания, очереди, каталог&lt;br&gt;&lt;br&gt;Доступ: users, sessions, audit_log&lt;br&gt;Подключения: servers, clusters, hosts&lt;br&gt;Копии: backup_jobs, backup_tasks, backup_runs,&lt;br&gt;backup_disks, backup_copies&lt;br&gt;Проверка и возврат: verify_runs, restore_runs&lt;br&gt;Присмотр: alerts, notification_deliveries" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1410" y="490" width="430" height="210" as="geometry"/></mxCell><mxCell id="v78" value="&lt;b&gt;Ведущий и ведомые&lt;/b&gt; (cluster.leader_election)&lt;br&gt;ведущий держит консультативную блокировку: расписание,&lt;br&gt;наблюдение, оживление; ведомые берут только переносы" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1410" y="720" width="430" height="76" as="geometry"/></mxCell><mxCell id="v79" value="&lt;b&gt;Старт и остановка&lt;/b&gt;&lt;br&gt;старт: найти запуски «выполняется», закрыть бэкапы на движке,&lt;br&gt;убрать снапшоты · SIGTERM: дренаж HTTP, отмена бэкапов&lt;br&gt;с записью «прервано»" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1410" y="810" width="430" height="76" as="geometry"/></mxCell><mxCell id="v80" value="&lt;b&gt;Оживление&lt;/b&gt;: три ворот — политика, cooldown, лимит в час;&lt;br&gt;по умолчанию режим проверки (dry run)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1410" y="900" width="430" height="56" as="geometry"/></mxCell><mxCell id="v81" value="🔒 secret: AES-256-GCM, ключ 0600, в API не сериализуется · repo local: os.Root — без «..», абсолютных ключей и symlink · sshtrust: пустой host key = нет подключения, отказ от проверки — явный флаг в аудите" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="530" y="856" width="820" height="36" as="geometry"/></mxCell><mxCell id="v82" value="🔒 роль ovirt_backup_app без SUPERUSER · JSONB отвергает некорректные данные при записи" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1410" y="970" width="430" height="30" as="geometry"/></mxCell><mxCell id="v83" value="🔒 незавершённый бэкап и снапшот закрываются через defer с контекстом, переживающим отмену" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1410" y="1010" width="430" height="30" as="geometry"/></mxCell><mxCell id="v84" value="🔒 разморозка гостя — отдельный контекст на 60 с, даже при отмене" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1410" y="1050" width="430" height="22" as="geometry"/></mxCell><mxCell id="v85" value="⚠ захват процесса = доступ к secret.key, паролям движков и ключам хранилищ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1410" y="1082" width="430" height="30" as="geometry"/></mxCell><mxCell id="v86" value="🔒 ответ «нет пользователя» и «неверный пароль» одинаков и по времени (bcrypt-заглушка)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="530" y="225" width="820" height="22" as="geometry"/></mxCell><mxCell id="v87" value="🔒 сокет root:jhvirt 0660 · только фиксированные операции над Keycloak" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="530" y="1105" width="400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Бэкап oVirt / РЕД"><mxGraphModel dx="1880" dy="1602" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1602" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" value="Схема" parent="0"/><mxCell id="sec" value="Защита" parent="0"/><mxCell id="v1" value="4. Бэкап ВМ oVirt / РЕД Виртуализации: Backup API + ovirt-imageio" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1820" height="34" as="geometry"/></mxCell><mxCell id="v2" value="Инкрементальный путь через CBT (checkpoint движка). Справа — что защищает каждый шаг; оранжевым — известные ограничения. Внизу — запасной путь через снапшот." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1820" height="40" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Что защищает шаг&lt;/b&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1560" y="118" width="300" height="40" as="geometry"/></mxCell><mxCell id="v70" value="&lt;b&gt;Служба&lt;/b&gt;&lt;br&gt;планировщик и движок" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="45" y="110" width="190" height="58" as="geometry"/></mxCell><mxCell id="a71" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="168" as="sourcePoint"/><mxPoint x="140" y="1392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v72" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;очередь и каталог" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="190" height="58" as="geometry"/></mxCell><mxCell id="a73" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="168" as="sourcePoint"/><mxPoint x="355" y="1392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v74" value="&lt;b&gt;Движок oVirt / РЕД&lt;/b&gt;&lt;br&gt;REST :443" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="475" y="110" width="190" height="58" as="geometry"/></mxCell><mxCell id="a75" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="168" as="sourcePoint"/><mxPoint x="570" y="1392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v76" value="&lt;b&gt;Гость&lt;/b&gt;&lt;br&gt;qemu-guest-agent" st