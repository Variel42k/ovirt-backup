ARG POSTGRES_BASE_IMAGE=docker.io/library/postgres:17-alpine@sha256:18cfe3ef5e6815560c98237d6216d1e5119702fb0f3894c8785dd58b8bbe5d73
FROM ${POSTGRES_BASE_IMAGE}

# В закреплённом базовом образе OpenSSL 3.5.7-r0, а gosu собран на старом Go.
# Обновляем затронутые библиотеки и заменяем gosu совместимой утилитой Alpine,
# написанной на C. Явные версии позволяют контролировать изменения образа БД.
USER root
RUN apk add --no-cache --upgrade \
        libcrypto3=3.5.8-r0 \
        libssl3=3.5.8-r0 \
        su-exec=0.3-r0 \
    && cp /sbin/su-exec /usr/local/bin/gosu \
    && gosu nobody true

# Compose применяет root только к контейнеру самой БД. Скрипт входа готовит
# новый том, назначает владельца и переключается на postgres.
# Контейнеры резервного копирования используют заданные непривилегированные учётные записи.
USER postgres
