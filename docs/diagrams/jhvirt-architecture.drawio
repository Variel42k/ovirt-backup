n=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1232" y="1168" width="90" height="20" as="geometry"/></mxCell><mxCell id="v83" value="⚠ остаточный риск" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1328" y="1168" width="130" height="20" as="geometry"/></mxCell><mxCell id="v84" value="&lt;i&gt;Слой «Защита» скрывается: Вид → Слои (Ctrl+Shift+L)&lt;/i&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1230" y="1192" width="460" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7. Формат копии и шифрование"><mxGraphModel dx="1880" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" value="Схема" parent="0"/><mxCell id="sec" value="Защита" parent="0"/><mxCell id="v1" value="7. Формат копии jhvirt-disk и шифрование" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1820" height="34" as="geometry"/></mxCell><mxCell id="v2" value="Всё, что нужно для восстановления, лежит рядом с данными: БД службы для чтения копии не нужна. Слой «Защита» — что обеспечивает целостность и конфиденциальность и что остаётся видимым без ключа." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1820" height="40" as="geometry"/></mxCell><mxCell id="v3" value="Раскладка в хранилище" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="560" height="420" as="geometry"/></mxCell><mxCell id="v4" value="jhvirt/&lt;br&gt;└─ &amp;lt;сервер&amp;gt;/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;└─ &amp;lt;имя-вм&amp;gt;-&amp;lt;8 симв. id&amp;gt;/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└─ 2026/08/03/ &amp;nbsp;(дата запуска, UTC)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└─ &amp;lt;uuid-запуска&amp;gt;/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├─ vm-config.json | vm-config.xml&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├─ disk-00-&amp;lt;disk&amp;gt;.manifest&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├─ disk-00-&amp;lt;disk&amp;gt;.data&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├─ artifact-00-….qcow2 | .proxmox-vzdump&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└─ run.json &amp;nbsp;← пишется последним&lt;br&gt;&lt;br&gt;jhvirt/files/&amp;lt;root-id&amp;gt;/…/files.manifest &amp;nbsp;— файловые копии&lt;br&gt;jhvirt/engine-config/&amp;lt;сервер&amp;gt;/…/&amp;lt;run&amp;gt;.json[.enc]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#263238;strokeColor=#263238;fontColor=#eceff1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="520" height="300" as="geometry"/></mxCell><mxCell id="v5" value="Имена сегментов приводятся к ASCII (кириллица транслитерируется) — путь набирается в любой консоли." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="458" width="520" height="30" as="geometry"/></mxCell><mxCell id="v6" value="Запись одного чанка (DiskWriter)" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="1260" height="420" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Экстент диска&lt;/b&gt;&lt;br&gt;imageio / NBD / vzdump" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="158" height="90" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Сетка&lt;/b&gt;&lt;br&gt;i = смещение ÷ 4 МиБ&lt;br&gt;сетка корня на всю цепочку" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="798" y="150" width="158" height="90" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=10;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v10" value="&lt;b&gt;h = SHA-256&lt;/b&gt;&lt;br&gt;открытых байт" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="976" y="150" width="158" height="90" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=10;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v8" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v12" value="&lt;b&gt;Сжатие&lt;/b&gt;&lt;br&gt;zstd | gzip | s2 | none&lt;br&gt;нет выигрыша → как есть" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1154" y="150" width="158" height="90" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=10;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v10" target="v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v14" value="&lt;b&gt;AES-256-GCM&lt;/b&gt;&lt;br&gt;если включено в задании" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1332" y="150" width="158" height="90" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=10;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v12" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v16" value="&lt;b&gt;Дописать в .data&lt;/b&gt;&lt;br&gt;b = смещение, s = длина" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1510" y="150" width="158" height="90" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=10;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v14" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v18" value="&lt;b&gt;Строка манифеста&lt;/b&gt;&lt;br&gt;{i, l, b, s, h}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#263238;strokeColor=#263238;fontColor=#eceff1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1688" y="150" width="158" height="90" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v16" target="v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v20" value="&lt;b&gt;Объект .data&lt;/b&gt; — чанки подряд по возрастанию i, каждый независим" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="262" width="700" height="22" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;чанк 0&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="290" width="150" height="44" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;чанк 1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="774" y="290" width="110" height="44" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;чанк 7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="888" y="290" width="180" height="44" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b&gt;чанк 8&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1072" y="290" width="90" height="44" as="geometry"/></mxCell><mxCell id="v25" value="…" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1166" y="290" width="60" height="44" as="geometry"/></mxCell><mxCell id="v26" value="&lt;b&gt;чанк N&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1230" y="290" width="120" height="44" as="geometry"/></mxCell><mxCell id="v27" value="nonce 12 B" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="620" y="342" width="90" height="26" as="geometry"/></mxCell><mxCell id="v28" value="шифртекст (s − 28 B)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#263238;strokeColor=#263238;fontColor=#eceff1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontFamily=Helvetica;fontSize=10;align=center;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="714" y="342" width="250" height="26" as="geometry"/></mxCell><mxCell id="v29" value="тег 16 B" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="968" y="342" width="80" height="26" as="geometry"/></mxCell><mxCell id="v30" value="← устройство одного чанка при шифровании" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1056" y="342" width="280" height="26" as="geometry"/></mxCell><mxCell id="v31" value="Даже при выбранном алгоритме несжимаемый чанк хранится без сжатия: после расшифровки s = l означает исходные байты. Порядок обязателен — сжатие до шифрования." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="376" width="720" height="36" as="geometry"/></mxCell><mxCell id="v32" value="&lt;b&gt;Манифест диска&lt;/b&gt; — zstd JSON, открыт&lt;br&gt;{&quot;format&quot;:&quot;jhvirt-disk&quot;,&quot;version&quot;:1,&lt;br&gt; &quot;chunk_size&quot;:4194304,&quot;encrypted&quot;:true,&lt;br&gt; &quot;data_sha256&quot;:&quot;…&quot;,&lt;br&gt; &quot;chunks&quot;:[{&quot;i&quot;:0,&quot;l&quot;:4194304,&quot;b&quot;:0,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;s&quot;:1048604,&quot;h&quot;:&quot;…&quot;}, …]}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#263238;strokeColor=#263238;fontColor=#eceff1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1360" y="262" width="480" height="150" as="geometry"/></mxCell><mxCell id="v33" value="&lt;b&gt;run.json&lt;/b&gt; — открыт, пишется последним: тип, цепочка (chain_id, parent_run_id, chain_index), checkpoint-ы, диски, vm_profile, артефакты" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="420" width="1220" height="44" as="geometry"/></mxCell><mxCell id="v34" value="Сборка образа из цепочки: «побеждает самый свежий запуск, в котором есть чанк i»" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="900" height="420" as="geometry"/></mxCell><mxCell id="v35" value="&lt;b&gt;full&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="150" height="40" as="geometry"/></mxCell><mxCell id="v36" value="0" style="rounded=0;html=1;fillColor=#c8e6c9;strokeColor=#9e9e9e;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="200" y="610" width="60" height="40" as="geometry"/></mxCell><mxCell id="v37" value="1" style="rounded=0;html=1;fillColor=#c8e6c9;strokeColor=#9e9e9e;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="266" y="610" width="60" height="40" as="geometry"/></mxCell><mxCell id="v38" value="2" style="rounded=0;html=1;fillColor=#c8e6c9;strokeColor=#9e9e9e