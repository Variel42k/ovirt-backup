le="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="790" y="396" width="140" height="44" as="geometry"/></mxCell><mxCell id="v37" value="🔒 порча или подмена чанка видна сразу, а не после загрузки ВМ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="790" y="560" width="140" height="56" as="geometry"/></mxCell><mxCell id="v38" value="Поток идёт через io.Pipe: образ не собирается целиком на сервере копий, если цель — диск или ВМ." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="740" width="560" height="40" as="geometry"/></mxCell><mxCell id="v39" value="Куда" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="900" height="720" as="geometry"/></mxCell><mxCell id="v40" value="&lt;b&gt;Файл-образ на сервере копий&lt;/b&gt;&lt;br&gt;raw / qcow2 в каталоге из backup.restore_dirs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="980" y="150" width="380" height="76" as="geometry"/></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=10;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exi