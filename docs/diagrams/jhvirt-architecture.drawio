ed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="1166" width="26" height="26" as="geometry"/></mxCell><mxCell id="v58" value="🔒 исходный XML хранится для аудита; при восстановлении домен строится из белого списка полей" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1540" y="1164" width="320" height="30" as="geometry"/></mxCell><mxCell id="v71" value="&lt;b&gt;Почему инкремент зависит от формата диска&lt;/b&gt;&lt;br&gt;persistent dirty bitmap хранится в заголовке qcow2. У raw-диска битмапа нет — libvirt отверг бы checkpoint целиком, поэтому такая ВМ копируется полностью и на горячую тем же pull-экспортом." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1232" width="620" height="90" as="geometry"/></mxCell><mxCell id="v72" value="&lt;b&gt;Отличия от oVirt&lt;/b&gt;&lt;br&gt;• нет движка: кластеров, доменов хранения, обслуживания и fencing&lt;br&gt;• checkpoint создаёт служба, а не движок&lt;br&gt;• проверка boot поднимает transient-домен без сетевых интерфейсов" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680" y="1232" width="520" height="90" as="geometry"/></mxCell><mxCell id="v73" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1220" y="1232" width="480" height="158" as="geometry"/></mxCell><mxCell id="v74" value="&lt;b&gt;Легенда&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1230" y="1238" width="200" height="20" as="geometry"/></mxCell><mxCell id="v75" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1232" y="1264" width="30" height="16" as="geometry"/></mxCell><mxCell id="v76" value="Сервер копий (ovirt-backup)" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1270" y="1261" width="185" height="22" as="geometry"/></mxCell><mxCell id="v77" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1232" y="1288" width="30" height="16" as="geometry"/></mxCell><mxCell id="v78" value="Платформы виртуализации" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1270" y="1285" width="185" height="22" as="geometry"/></mxCell><mxCell id="v79" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1232" y="1312" width="30" height="16" as="geometry"/></mxCell><mxCell id="v80" value="Хранилища и данные" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1270" y="1309" width="185" height="22" as="geometry"/></mxCell><mxCell id="v81" value="" style="rounded=0;fillColor=#2e7d32;strokeColor=#2e7d32;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1462" y="1271" width="30" height="2" as="geometry"/></mxCell><mxCell id="v82" value="Поток данных копии" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1500" y="1261" width="185" height="22" as="geometry"/></mxCell><mxCell id="v83" value="" style="rounded=0;fillColor=#546e7a;strokeColor=#546e7a;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1462" y="1295" width="30" height="2" as="geometry"/></mxCell><mxCell id="v84" value="Управляющий вызов" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1500" y="1285" width="185" height="22" as="geometry"/></mxCell><mxCell id="v85" value="🔒 защита" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1232" y="1336" width="90" height="20" as="geometry"/></mxCell><mxCell id="v86" value="⚠ остаточный риск" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1328" y="1336" width="130" height="20" as="geometry"/></mxCell><mxCell id="v87" value="&lt;i&gt;Слой «Защита» скрывается: Вид → Слои (Ctrl+Shift+L)&lt;/i&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1230" y="1360" width="460" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. Бэкап Proxmox VE"><mxGraphModel dx="1880" dy="1254" grid="1" gridSize="10" guides="1" tooltips="1" connec