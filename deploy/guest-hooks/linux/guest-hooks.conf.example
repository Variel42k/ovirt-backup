# /etc/jhvirt/guest-hooks.conf — настройки сценариев заморозки jhvirt.
#
# Файл выполняется как shell-сценарий от root при каждой заморозке, поэтому
# сценарии откажутся его читать, если он не принадлежит root или доступен на
# запись группе и другим. Права: root:root 0600.

# Сколько секунд сценарий ждёт СУБД (CHECKPOINT, FLUSH TABLES WITH READ LOCK).
# Служба копий ждёт заморозку целиком около минуты: держите запас.
#JHVIRT_HOOK_TIMEOUT=30

# PostgreSQL: системный пользователь, порты кластеров через пробел и каталог
# сокета, если он не стандартный (/var/run/postgresql или /tmp).
#JHVIRT_PG_OS_USER=postgres
#JHVIRT_PG_PORTS="5432"
#JHVIRT_PG_SOCKET_DIR=

# MySQL / MariaDB: клиент (по умолчанию mariadb или mysql из PATH), файл
# параметров с учётной записью и предельный срок удержания блокировки.
#JHVIRT_MYSQL_CLIENT=
#JHVIRT_MYSQL_DEFAULTS_FILE=/etc/jhvirt/mysql-freeze.cnf
#JHVIRT_MYSQL_HOLD=120

# --- Kubernetes: СУБД в подах на этом узле ---------------------------------
#
# Цели — пространство_имён/имя_контейнера через пробел. Контейнеры ищутся
# через crictl по меткам kubelet только на этом узле: под, работающий на
# другом узле, пропускается (его данных на дисках этой ВМ нет). Учётные
# данные Kubernetes сценариям не нужны.
#
# Когда цели заданы, СУБД на самой ВМ не готовится, пока это не сказано явно:
# JHVIRT_PG_PORTS для PostgreSQL, JHVIRT_MYSQL_ON_HOST=1 для MySQL.
#
# crictl: для k3s и RKE2 — "k3s crictl" или полный путь с CONTAINER_RUNTIME_ENDPOINT.
#JHVIRT_CRICTL=crictl

# PostgreSQL в подах: роль и имя переменной окружения КОНТЕЙНЕРА с её
# паролем (пароль на узле не хранится). Официальный образ пускает postgres
# через сокет без пароля; образам Bitnami нужен пароль, например
# JHVIRT_PG_K8S_PASSWORD_ENV=POSTGRES_POSTGRES_PASSWORD.
#JHVIRT_PG_K8S_TARGETS="shop/postgres"
#JHVIRT_PG_K8S_USER=postgres
#JHVIRT_PG_K8S_PASSWORD_ENV=

# MySQL / MariaDB в подах: учётная запись с RELOAD и переменная окружения
# контейнера с её паролем (например, MYSQL_ROOT_PASSWORD или MARIADB_ROOT_PASSWORD).
#JHVIRT_MYSQL_K8S_TARGETS="shop/mysql"
#JHVIRT_MYSQL_K8S_USER=root
#JHVIRT_MYSQL_K8S_PASSWORD_ENV=MYSQL_ROOT_PASSWORD
#JHVIRT_MYSQL_ON_HOST=0
