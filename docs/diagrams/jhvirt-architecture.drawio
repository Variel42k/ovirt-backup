Color=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="295" y="110" width="190" height="58" as="geometry"/></mxCell><mxCell id="a58" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="168" as="sourcePoint"/><mxPoint x="390" y="1044" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v59" value="&lt;b&gt;Узел-владелец&lt;/b&gt;&lt;br&gt;sshd + jhvirt-pve-data-plane" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="545" y="110" width="190" height="58" as="geometry"/></mxCell><mxCell id="a60" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="168" as="sourcePoint"/><mxPoint x="640" y="1044" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v61" value="&lt;b&gt;vzdump / qmrestore / pct&lt;/b&gt;&lt;br&gt;root на узле" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="795" y="110" width="190" height="58" as="geometry"/></mxCell><mxCell id="a62" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="168" as="sourcePoint"/><mxPoint x="890" y="1044" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v63" value="&lt;b&gt;DiskWriter&lt;/b&gt;&lt;br&gt;в службе" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1045" y="110" width="190" height="58" as="geometry"/></mxCell><mxCell id="a64" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="168" as="sourcePoint"/><mxPoint x="1140" y="1044" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v65" value="&lt;b&gt;Хранилище копий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1295" y="110" width="190" height="58" as="geometry"/></mxCell><mxCell id="a66" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1390" y="168" as="sourcePoint"/><mxPoint x="1390" y="1044" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v4" value="1. Инвентарь и выбор узла" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ede7f6;strokeColor=#5e35b1;dashed=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="1450" height="24" as="geometry"/></mxCell><mxCell id="a5" value="GET /cluster/resources, конфигурация qemu | lxc" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="247" as="sourcePoint"/><mxPoint x="390" y="247" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v6" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="232" width="26" height="26" as="geometry"/></mxCell><mxCell id="v7" value="🔒 API token по HTTPS с проверкой CA; token и 