ec" value="Защита" parent="0"/><mxCell id="v1" value="3. Устройство службы: путь запроса, пакеты, фоновые процессы" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1820" height="34" as="geometry"/></mxCell><mxCell id="v2" value="Один процесс ovirt-backup: HTTP-слой, планировщик, наблюдение и движки копирования. Зависимости пакетов идут строго сверху вниз. Слой «Защита» — проверки на каждом шаге запроса и в пакетах." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1820" height="40" as="geometry"/></mxCell><mxCell id="v3" value="Путь HTTP-запроса" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="470" height="1100" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;TLS&lt;/b&gt;&lt;br&gt;свой сертификат из jhvirt-data&lt;br&gt;или обратный прокси" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="250" height="92" as="geometry"/></mxCell><mxCell id="v5" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="144" width="26" height="26" as="geometry"/></mxCell><mxCell id="v6" value="🔒 HSTS при HTTPS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="300" y="168" width="176" height="56" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Заголовки ответа&lt;/b&gt;&lt;br&gt;CSP, запрет framing и MIME sniffing,&lt;br&gt;Referrer- и Permissions-Policy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="278" width="250" height="92" as="geometry"/></mxCell><mxCell id="v8" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="272" width="26" height="26" as="geometry"/></mxCell><mxCell id="v9" value="🔒 API: Cache-Control no-store" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="300" y="296" width="176" height="56" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v11" value="&lt;b&gt;Проверка Origin&lt;/b&gt;&lt;br&gt;для изменяющих запросов браузера" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="250" height="92" as="geometry"/></mxCell><mxCell id="v12" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontS