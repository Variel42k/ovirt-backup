0" height="24" as="geometry"/></mxCell><mxCell id="a59" value="POST /backups/{id}/finalize, ожидание до 5 мин" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="1229" as="sourcePoint"/><mxPoint x="570" y="1229" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v60" value="20" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="1214" width="26" height="26" as="geometry"/></mxCell><mxCell id="v61" value="🔒 выполняется при ошибке и при отмене — диски не останутся заблокированными" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1560" y="1212" width="300" height="30" as="geometry"/></mxCell><mxCell id="a62" value="run.json — последним" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="1269" as="sourcePoint"/><mxPoint x="1430" y="1269" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v63" value="21" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="1254" width="26" height="26" as="geometry"/></mxCell><mxCell id="v64" value="🔒 нет run.json — нет точки: ни каталог, ни jvbackup не примут обрывок" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1560" y="1252" width="300" height="30" as="geometry"/></mxCell><mxCell id="a65" value="backup_runs: статус,&lt;br&gt;checkpoint" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="1322" as="sourcePoint"/><mxPoint x="355" y="1322" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v66" value="22" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="1294" width="26" height="26" as="geometry"/></mxCell><mxCell id="a67" value="копии в запасные хранилища, проверка после бэкапа" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=3;fontSize=11;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="1361" as="sourcePoint"/><mxPoint x="1430" y="1361" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v68" value="23" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="1346" width="26" height="26" as="geometry"/></mxCell><mxCell id="v69" value="🔒 реплика перечитывается и сверяется по SHA-256; run.json переносится последним" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1560" y="1344" width="300" height="30" as="geometry"/></mxCell><mxCell id="v84" value="&lt;b&gt;Запасной путь без CBT — тип snapshot&lt;/b&gt;&lt;br&gt;1. freeze → POST /vms/{id}/snapshots (только диски, без памяти) → thaw&lt;br&gt;2. /imagetransfers по image_id диска снапшота → те же шаги копирования, контекст zero&lt;br&gt;3. DELETE снапшота → слияние на гипервизоре, ожидание до 30 мин" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1412" width="640" height="110" as="geometry"/></mxCell><mxCell id="v85" value="&lt;b&gt;Отказы&lt;/b&gt;&lt;br&gt;• один диск не сохранён → запуск partial, остальные диски годны&lt;br&gt;• ни одного → failed; блокировка движка и передачи закрываются&lt;br&gt;• при старте службы: зависшие «выполняется» закрываются на движке" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffebee;strokeColor=#c62828;fontSize=11;spacing=6;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="1412" width="520" height="110" as="geometry"/></mxCell><mxCell id="v86" value="🔒 временный снапшот удаляется в defer: оставленный снапшот растит цепочку дисков до остановки ВМ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="40" y="1528" width="640" height="26" as="geometry"/></mxCell><mxCell id="v87" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1240" y="1412" width="480" height="158" as="geometry"/></mxCell><mxCell id="v88" value="&lt;b&gt;Легенда&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1250" y="1418" width="200" height="20" as="geometry"/></mxCell><mxCell id="v89" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1252" y="1444" width="30" height="16" as="geometry"/></mxCell><mxCell id="v90" value="Сервер копий (ovirt-backup)" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1290" y="1441" width="185" height="22" as="geometry"/></mxCell><mxCell id="v91" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1252" y="1468" width="30" height="16" as="geometry"/></mxCell><mxCell id="v92" value="Платформы виртуализации" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1290" y="1465" width="185" height="22" as="geometry"/></mxCell><mxCell id="v93" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1252" y="1492" width="30" height="16" as="geometry"/></mxCell><mxCell id="v94" value="Хранилища и данные" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1290" y="1489" width="185" height="22" as="geometry"/></mxCell><mxCell id="v95" value="" style="rounded=0;fillColor=#2e7d32;strokeColor=#2e7d32;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1482" y="1451" width="30" height="2" as="geometry"/></mxCell><mxCell id="v96" value="Поток данных копии" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1520" y="1441" width="185" height="22" as="geometry"/></mxCell><mxCell id="v97" value="" style="rounded=0;fillColor=#546e7a;strokeColor=#546e7a;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1482" y="1475" width="30" height="2" as="geometry"/></mxCell><mxCell id="v98" value="Управляющий вызов" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1520" y="1465" width="185" height="22" as="geometry"/></mxCell><mxCell id="v99" value="🔒 защита" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1252" y="1516" width="90" height="20" as="geometry"/></mxCell><mxCell id="v100" value="⚠ остаточный риск" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1348" y="1516" width="130" height="20" as="geometry"/></mxCell><mxCell id="v101" value="&lt;i&gt;Слой «Защита» скрывается: Вид → Слои (Ctrl+Shift+L)&lt;/i&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="1540" width="460" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. Бэкап KVM (libvirt)"><mxGraphModel dx="1880" dy="1422" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1422" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" value="Схема" parent="0"/><mxCell id="sec" value="Защита" parent="0"/><mxCell id="v1" value="5. Бэкап ВМ на голом KVM: libvirt backup API в pull-режиме + NBD через SSH" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1820" height="34" as="geometry"/></mxCell><mxCell id="v2" value="Движка нет: служба сама создаёт checkpoint и читает диски по NBD. Весь трафик — внутри одного SSH-соединения, отдельных портов на хосте не открывается." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1820" height="40" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Что защищает шаг&lt;/b&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1540" y="118" width="320" height="40" as="geometry"/></mxCell><mxCell id="v59" value="&lt;b&gt;Служба&lt;/b&gt;&lt;br&gt;драйвер kvm + libvirtx" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="45" y="110" width="190" height="58" as="geometry"/></mxCell><mxCell id="a60" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="168" as="sourcePoint"/><mxPoint x="140" y="1212" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v61" value="&lt;b&gt;libvirtd&lt;/b&gt; на KVM-хосте&lt;br&gt;через SSH-туннель" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x