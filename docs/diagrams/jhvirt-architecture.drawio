="26" height="26" as="geometry"/></mxCell><mxCell id="v15" value="🔒 без паролей в сценариях: локальный сокет и peer / unix_socket-аутентификация" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1200" y="418" width="380" height="30" as="geometry"/></mxCell><mxCell id="a16" value="MySQL / MariaDB: фоновая сессия&lt;br&gt;FLUSH TABLES WITH READ LOCK; SELECT SLEEP(120)" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5e35b1;strokeWidth=2;fontSize=11;fontColor=#4527a0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="488" as="sourcePoint"/><mxPoint x="1050" y="488" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v17" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="460" width="26" height="26" as="geometry"/></mxCell><mxCell id="v18" value="🔒 блокировка ограничена жизнью сессии: без thaw она снимется сама через 120 с" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1200" y="458" width="380" height="30" as="geometry"/></mxCell><mxCell id="v19" value="⚠ FTWRL ждёт завершения длинных запросов — тайм-аут 30 с, затем хук завершается ошибкой" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1200" y="492" width="380" height="30" as="geometry"/></mxCell><mxCell id="a20" value="блокировка получена" style="rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#78909c;fontSize=11;fontColor=#455a64;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="547" as="sourcePoint"/><mxPoint x="820" y="547" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v21" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="532" width="26" height="26" as="geometry"/></mxCell><mxCell id="a22" value="exit 0 · при сбое: thaw подготовленным, exit ≠ 0" style="rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#78909c;fontSize=11;fontColor=#455a64;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="587" as="sourcePoint"/><mxPoint x="590" y="587" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v23" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="572" width="26" height="26" as="geometry"/></mxCell><mxCell id="v24" value="🔒 ненулевой код хука — агент отменяет заморозку, СУБД не остаётся под блокировкой" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1200" y="570" width="380" height="30" as="geometry"/></mxCell><mxCell id="a25" value="" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="