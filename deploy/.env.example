# Боевая конфигурация justhpc-virt-manager.
#
#   cp .env.example .env && chmod 600 .env
#
# Файл содержит пароль СУБД, поэтому права 0600. Переменные без значения по
# умолчанию обязательны: без них compose откажется запускаться и назовёт, чего
# не хватает. Так задумано — установка с паролем «на первое время» живёт в бою
# дольше, чем предполагалось, и по журналу неотличима от настоящей.

# --- СУБД -------------------------------------------------------------------
# Пароль сгенерируйте, а не придумывайте:  openssl rand -base64 24
# Символы / и + в нём допустимы: строка подключения собирается в форме
# host=… , где экранирование не требуется.
POSTGRES_USER=jhvirt
POSTGRES_PASSWORD=
POSTGRES_DB=jhvirt

# --- Адрес ------------------------------------------------------------------
# По нему интерфейс открывают в браузере. https здесь включает флаг Secure у
# куки сессии — даже когда TLS терминирует обратный прокси, а сервис слушает
# http. Обязателен именно поэтому.
JHV_EXTERNAL_URL=https://virt.example.org

# Порт наружу. За обратным прокси разумно оставить 127.0.0.1:8080:8080,
# чтобы сервис не смотрел в сеть напрямую.
JHV_PORT=8080

# --- Учётная запись ---------------------------------------------------------
# Пусто — пароль администратора будет сгенерирован и напечатан один раз при
# первом запуске. Задавать здесь свой не нужно: он останется в файле.
JHV_ADMIN_PASSWORD=

# --- Каталоги ---------------------------------------------------------------
# Локальное хранилище копий. Смонтируйте сюда NFS-шару или отдельный том.
JHV_BACKUP_DIR=/srv/backups
# Куда складывать восстановленные образы. Отдельно от копий: восстановление не
# должно съедать место под сами копии.
JHV_RESTORE_DIR=/srv/restores

# --- Необязательное ---------------------------------------------------------
# Версия в теге образа — чтобы потом было видно, что развёрнуто.
VERSION=1.0.0
TZ=Europe/Moscow

# Журнал в файл: нужен, если хотите читать его из интерфейса. Пусто — журнал
# уходит в поток контейнера и его забирает docker logs.
# JHV_LOG_FILE=/app/logs/jhvirt.log

# Дополнительные каталоги восстановления (через запятую). Каждый должен быть
# смонтирован в контейнер.
# JHV_RESTORE_DIRS=/restores,/mnt/restore

# Адреса, которым разрешены межсайтовые запросы к API. Заполнять только если
# интерфейс раздаётся не этим же процессом.
# JHV_CORS_ORIGINS=https://other.example.org
