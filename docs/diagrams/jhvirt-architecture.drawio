etry x="1480" y="370" width="190" height="36" as="geometry"/></mxCell><mxCell id="v58" value="откат неудачного восстановления" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1676" y="370" width="170" height="36" as="geometry"/></mxCell><mxCell id="v59" value="&lt;b&gt;configure_disk_storage&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#263238;strokeColor=#263238;fontColor=#eceff1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontFamily=Helvetica;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1480" y="414" width="190" height="36" as="geometry"/></mxCell><mxCell id="v60" value="размещение диска в домене" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1676" y="414" width="170" height="36" as="geometry"/></mxCell><mxCell id="v61" value="&lt;b&gt;create_vm&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#263238;strokeColor=#263238;fontColor=#eceff1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontFamily=Helvetica;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1480" y="458" width="190" height="36" as="geometry"/></mxCell><mxCell id="v62" value="восстановление новой ВМ" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1676" y="458" width="170" height="36" as="geometry"/></mxCell><mxCell id="v63" value="&lt;b&gt;edit_vm_properties&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#263238;strokeColor=#263238;fontColor=#eceff1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontFamily=Helvetica;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1480" y="502" width="190" height="36" as="geometry"/></mxCell><mxCell id="v64" value="настройка восстановленной ВМ" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1676" y="502" width="170" height="36" as="geometry"/></mxCell><mxCell id="v65" value="&lt;b&gt;configure_vm_storage&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#263238;strokeColor=#263238;fontColor=#eceff1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontFamily=Helvetica;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1480" y="546" width="190" height="36" as="geometry"/></mxCell><mxCell id="v66" value="подключение дисков к ВМ" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1676" y="546" width="170" height="36" as="geometry"/></mxCell><mxCell id="v67" value="Каталог РЕД 7.3: 99 прав на каждом уровне 4.2–4.6, набор и id совпадают." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="594" width="360" height="36" as="geometry"/></mxCell><mxCell id="v68" value="Три сценария одного мастера" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="900" height="250" as="geometry"/></mxCell><mxCell id="v69" value="&lt;b&gt;Новое подключение&lt;/b&gt;&lt;br&gt;адрес, CA и обе записи вводятся в мастере" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="270" height="80" as="geometry"/></mxCell><mxCell id="v70" value="&lt;b&gt;Дочинить права&lt;/b&gt;&lt;br&gt;та же сервисная запись: роль дополняется и проверяется" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="850" width="270" height="80" as="geometry"/></mxCell><mxCell id="v71" value="&lt;b&gt;Понизить права&lt;/b&gt;&lt;br&gt;отдельная сервисная запись; подключение переключается на неё" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="850" width="270" height="80" as="geometry"/></mxCell><mxCell id="v72" value="Для уже добавленного подключения адрес, тип и параметры доверия берутся из сохранённого сервера и заново не вводятся. Пункт «Настроить сервисную запись» есть только у oVirt и совместимых движков." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="860" height="40" as="geometry"/></mxCell><mxCell id="v73" value="До и после" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="940" y="810" width="920" height="250" as="geometry"/></mxCell><mxCell id="v74" value="&lt;b&gt;Было&lt;/b&gt;: подключение под admin@internal&lt;br&gt;пароль администратора в БД службы годится для любых запросов к движку в обход проверок службы" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffebee;strokeColor=#c62828;fontSize=11;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="850" width="420" height="90" as="geometry"/></mxCell><mxCell id="v75" value="&lt;b&gt;Стало&lt;/b&gt;: jhvirt-backup@internal с ролью из 10 прав&lt;br&gt;администратор движка нигде не хранится" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1420" y="850" width="420" height="90" as="geometry"/></mxCell><mxCell id="v76" value="⚠ роль выдаётся на уровне системы: сервисная запись видит все ВМ движка и может удалять диски (delete_disk нужен откату восстановления)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="960" y="950" width="880" height="30" as="geometry"/></mxCell><mxCell id="v77" value="⚠ CheckAccess проверяет чтение; права на съём (backup_disk, передачи) подтверждает первый запуск задания" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="960" y="986" width="880" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p12" name="12. Карта защиты"><mxGraphModel dx="1880" dy="1254" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1254" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" value="Схема" parent="0"/><mxCell id="sec" value="Защита" parent="0"/><mxCell id="v1" value="12. Карта защиты: актив → чем защищён → остаточный риск" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1820" height="34" as="geometry"/></mxCell><mxCell id="v2" value="Сводная таблица по всем вкладкам. Красным — реализованные меры, оранжевым — риски, которые остаются и требуют организационных мер или следующих этапов." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1820" height="40" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Актив&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="226" height="36" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;Где хранится или проходит&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="256" height="36" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Чем защищено&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="510" y="110" width="556" height="36" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Кто может прочитать или изменить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="110" width="286" height="36" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Остаточный риск и что с ним делать&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1360" y="110" width="436" height="36" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Данные ВМ в копиях&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=12;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="226" height="52" as="geometry"/></mxCell><mxCell id="v9" value="хранилища: .data-объекты" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="150" width="256" height="52" as="geometry"/></mxCell><mxCell id="v10" value="🔒 AES-256-GCM на каждый чанк (включается в задании) · SHA-256 открытых данных в манифесте · реплики сверяются по SHA-256 · S3 Object Lock · карантин удаления 72 ч" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="150" width="556" height="52" as="geometry"/></mxCell><mxCell id="v11" value="служба; администратор хранилища — только шифртекст" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="150" width="286" height="52" as="geometry"/></mxCell><mxCell id="v12" value="⚠ без шифрования в задании данные читает владелец хранилища — включать шифрование для внешних хранилищ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="150" width="436" height="52" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Манифесты и run.json&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cfd8dc;fontSize=12;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="206" width="226" height="52" as="geometry"/></mxCell><mxCell id="v14" value="хранилища, рядом с данными" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="206" width="256" height="52" as="geometry"/></mxCell><mxCell id="v15" value="🔒 открыты намеренно: копию можно разобрать без БД и без ключа · run.json пишется последним" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="206" width="556" height="52" as="geometry"/></mxCell><mxCell id="v16" value="любой, кто читает хранилище" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="206" width="286" height="52" as="geometry"/></mxCell><mxCell id="v17" value="⚠ видны имена ВМ и дисков, размеры и SHA-256 открытых чанков; манифест не подписан — нужны права хранилища и Object Lock" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="206" width="436" height="52" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;secret.key&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=12;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="262" width="226" height="52" as="geometry"/></mxCell><mxCell id="v19" value="том jhvirt-data, копия в DR-комплекте" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="262" width="256" height="52" as="geometry"/></mxCell><mxCell id="v20" value="🔒 файл 0600, UID 10001, не через environment · в API не отдаётся · копия в dr-backups" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="262" width="556" height="52" as="geometry"/></mxCell><mxCell id="v21" value="процесс службы, root хоста" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="262" width="286" height="52" as="geometry"/></mxCell><mxCell id="v22" value="⚠ потеря необратима, ротации нет — хранить копию отдельно от копий ВМ и от dr-backups на том же хосте" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="262" width="436" height="52" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;Пароли и ключи подключений&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cfd8dc;fontSize=12;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="318" width="226" height="52" as="geometry"/></mxCell><mxCell id="v24" value="PostgreSQL: servers, storage_targets" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="318" width="256" height="52" as="geometry"/></mxCell><mxCell id="v25" value="🔒 AES-256-GCM ключом secret.key · браузеру после сохранения не возвращаются · вход по ключу, пароль при наличии ключа не отправляется" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="318" width="556" height="52" as="geometry"/></mxCell><mxCell id="v26" value="процесс службы" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="318" width="286" height="52" as="geometry"/></mxCell><mxCell id="v27" value="⚠ захват процесса раскрывает их все — сервисные записи с минимальными правами (вкладка 11)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="318" width="436" height="52" as="geometry"/></mxCell><mxCell id="v28" value="&lt;b&gt;Учётная запись движка&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=12;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="374" width="226" height="52" as="geometry"/></mxCell><mxCell id="v29" value="движок oVirt / РЕД" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="374" width="256" height="52" as="geometry"/></mxCell><mxCell id="v30" value="🔒 роль jhvirt-backup из 10 прав · администратор не хранится · CheckAccess после настройки" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="374" width="556" height="52" as="geometry"/></mxCell><mxCell id="v31" value="служба" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="374" width="286" height="52" as="geometry"/></mxCell><mxCell id="v32" value="⚠ роль на уровне системы, delete_disk есть — при необходимости сузить выдачу вручную" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="374" width="436" height="52" as="geometry"/></mxCell><mxCell id="v33" value="&lt;b&gt;БД службы&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cfd8dc;fontSize=12;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="226" height="52" as="geometry"/></mxCell><mxCell id="v34" value="том postgres-data, dump в dr-backups" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="430" width="256" height="52" as="geometry"/></mxCell><mxCell id="v35" value="🔒 сеть database internal, 5432 не публикуется · роль без SUPERUSER · scram-sha-256 · ежедневный dump 0600 с проверкой pg_restore --list" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="430" width="556" height="52" as="geometry"/></mxCell><mxCell id="v36" value="процесс службы, root хоста и Docker" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="430" width="286" height="52" as="geometry"/></mxCell><mxCell id="v37" value="⚠ dr-backups по умолчанию на том же хосте — выносить на отдельный mount" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="430" width="436" height="52" as="geometry"/></mxCell><mxCell id="v38" value="&lt;b&gt;Сессии и API-токены&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=12;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="486" width="226" height="52" as="geometry"/></mxCell><mxCell id="v39" value="PostgreSQL: sessions, api_tokens" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="486" width="256" height="52" as="geometry"/></mxCell><mxCell id="v40" value="🔒 хранятся SHA-256 и хеш секрета · cookie HttpOnly, Secure, SameSite=Lax · срок, отзыв, аудит" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="486" width="556" height="52" as="geometry"/></mxCell><mxCell id="v41" value="владелец токена" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="486" width="286" height="52" as="geometry"/></mxCell><mxCell id="v42" value="⚠ статические токены из YAML через БД не отзываются — держать список пустым" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="486" width="436" height="52" as="geometry"/></mxCell><mxCell id="v43" value="&lt;b&gt;Учётные записи людей&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cfd8dc;fontSize=12;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="542" width="226" height="52" as="geometry"/></mxCell><mxCell id="v44" value="Active Directory через Keycloak; локальные — bcrypt" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="542" width="256" height="52" as="geometry"/></mxCell><mxCell id="v45" value="🔒 LDAPS с корпоративным CA · bind-пароль в file vault (root 0440, только Keycloak) · маппер групп READ_ONLY · MFA на стороне провайдера · локальный вход при OIDC выключен" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="542" width="556" height="52" as="geometry"/></mxCell><mxCell id="v46" value="Keycloak; администратор AD" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="542" width="286" height="52" as="geometry"/></mxCell><mxCell id="v47" value="⚠ захват Keycloak = доступ к bind credential — отдельная read-only запись AD, быстро отзываемая" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="542" width="436" height="52" as="geometry"/></mxCell><mxCell id="v48" value="&lt;b&gt;Администратор Keycloak&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=12;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="598" width="226" height="52" as="geometry"/></mxCell><mxCell id="v49" value="БД Keycloak" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="598" width="256" height="52" as="geometry"/></mxCell><mxCell id="v50" value="🔒 только хеш пароля · bootstrap-записи удаляются · сброс — ovirt-backup-recover-keycloak с хоста" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="598" width="556" height="52" as="geometry"/></mxCell><mxCell id="v51" value="root хоста" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=11;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="598" width="286" height="52" as="geometry"/></mxCell><mxCell id="v52" value="⚠ после инцидента — сменить client secret, завершить сессии, проверить federation и группы" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontSize=11;" ve