90" height="50" as="geometry"/></mxCell><mxCell id="v38" value="основное" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1730" y="180" width="100" height="46" as="geometry"/></mxCell><mxCell id="v39" value="запасное" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1730" y="250" width="100" height="46" as="geometry"/></mxCell><mxCell id="e40" value="проход 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=10;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="v36" target="v37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e41" value="проход 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=10;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="v36" target="v37"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="12" as="offset"/></mxGeometry></mxCell><mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=10;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v37" target="v38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=10;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v37" target="v39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v44" value="N чтений диска; точки могут&lt;br&gt;отноститься к разному времени" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="306" width="370" height="40" as="geometry"/></mxCell><mxCell id="v45" value="&lt;b&gt;Очередь backup_copies&lt;/b&gt; — строки в PostgreSQL, а не брокер: их же показывает интерфейс и учитывает ретенция&lt;br&gt;• worker берёт задачу UPDATE … FOR UPDATE SKIP LOCKED, аренда 5 мин, продлевает только владелец&lt;br&gt;• инкремент публикуется после всей родительской цепочки: от полной точки к листу&lt;br&gt;• запуск остаётся waiting_copies, пока обязательные копии и артефакты не готовы&lt;br&gt;• восстановление берёт всю цепочку из одного физического хранилища, звенья не смешиваются" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="360" width="1180" height="116" as="geometry"/></mxCell><mxCell id="v46" value="🔒 объекты переносятся байт в байт, без расшифровки и пересжатия; назначение перечитывается целиком и сверяется по SHA-256; run.json — последним" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="660" y="484" width="580" height="44" as="geometry"/></mxCell><mxCell id="v47" value="🔒 аренда: упавший worker возвращает задачу сам; отобранную аренду нельзя продлить — нет второго потока" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1250" y="484" width="590" height="44" as="geometry"/></mxCell><mxCell id="v48" value="🔒 отказ зеркала не прерывает запуск: основное — источник истины, пропуск дошлёт очередь" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="660" y="536" width="580" height="30" as="geometry"/></mxCell><mxCell id="v49" value="Ретенция и удаление" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="900" height="490" as="geometry"/></mxCell><mxCell id="v50" value="&lt;b&gt;Правила «дед-отец-сын»&lt;/b&gt;&lt;br&gt;последние N, часовые, суточные,&lt;br&gt;недельные, месячные, годовые,&lt;br&gt;предельный возраст" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="200" height="96" as="geometry"/></mxCell><mxCell id="v51" value="&lt;b&gt;Сохранность цепочек&lt;/b&gt;&lt;br&gt;сохраняется инкремент →&lt;br&gt;сохраняются все предки&lt;br&gt;до полной копии" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="258" y="700" width="200" height="96" as="geometry"/></mxCell><mxCell id="e52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v50" target="v51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v53" value="&lt;b&gt;Последняя копия ВМ&lt;/b&gt;&lt;br&gt;не удаляется никогда" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="476" y="700" width="200" height="96" as="geometry"/></mxCell><mxCell id="e54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v51" target="v53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v55" value="&lt;b&gt;План&lt;/b&gt; с токеном предпросмотра&lt;br&gt;по всему набору точек" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="694" y="700" width="200" height="96" as="geometry"/></mxCell><mxCell id="e56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v53" target="v55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v57" value="&lt;b&gt;Согласование&lt;/b&gt; retention.apply&lt;br&gt;кворум 2 · токен плана в заявке" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="250" height="70" as="geometry"/></mxCell><mxCell id="v58" value="&lt;b&gt;Карантин&lt;/b&gt;&lt;br&gt;копия помечена удалённой,&lt;br&gt;данные целы 72 ч (purge_delay)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="840" width="250" height="70" as="geometry"/></mxCell><mxCell id="v59" value="&lt;b&gt;Стирание объектов&lt;/b&gt;&lt;br&gt;после срока карантина" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffebee;strokeColor=#c62828;fontSize=11;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="840" width="250" height="70" as="geometry"/></mxCell><mxCell id="e60" value="ручное применение" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v55" target="v57"><mxGeometry x="0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="754" y="818"/><mxPoint x="165" y="818"/></Array></mxGeometry></mxCell><mxCell id="e61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v57" target="v58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v58" target="v59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v63" value="🔒 новая копия между просмотром и подтверждением меняет токен — удаление останавливается, план строится заново" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="40" y="920" width="540" height="30" as="geometry"/></mxCell><mxCell id="v64" value="🔒 перед карантином — проверка зависимых: копию, от которой зависят инкременты, удалить нельзя" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="40" y="956" width="540" height="30" as="geometry"/></mxCell><mxCell id="v65" value="🔒 до конца карантина копию можно вернуть; S3 Object Lock отказывает в удалении до срока блокировки" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="620" y="920" width="280" height="56" as="geometry"/></mxCell><mxCell id="v66" value="🔒 удаление копий, хранилищ и заданий — опасные действия: согласование, аудит, break-glass с оповещением" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="40" y="992" width="860" height="22" as="geometry"/></mxCell><mxCell id="v67" value="Автоматическая ретенция идёт раз в час по правилам задания; удаление просроченного — отдельная задача раз в час. Поиск устаревших копий (нет свежей точки дольше порога) поднимает оповещение." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1026" width="860" height="40" as="geometry"/></mxCell><mxCell id="v68" value="Проверка копий: 8 режимов от дешёвых к дорогим" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="940" y="660" width="920" height="490" as="geometry"/></mxCell><mxCell id="v69" value="&lt;b&gt;quick&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="700" width="110" height="36" as="geometry"/></mxCell><mxCell id="v70" value="объекты на месте, размеры совпадают" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1076" y="700" width="480" height="36" as="geometry"/></mxCell><mxCell id="v71" value="секунды" style="rounded=1;html=1;fillColor=#e8f5e9;strokeColor=#bdbdbd;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1562" y="700" width="150" height="36" as="geometry"/></mxCell><mxCell id="v72" value="&lt;b&gt;chain&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="744" width="110" height="36" as="geometry"/></mxCell><mxCell id="v73" value="родители есть, checkpoint-ы стыкуются, покрытие полное" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1076" y="744" width="480" height="36" as="geometry"/></mxCell><mxCell id="v74" value="только метаданные" style="rounded=1;html=1;fillColor=#e8f5e9;strokeColor=#bdbdbd;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1562" y="744" width="150" height="36" as="geometry"/></mxCell><mxCell id="v75" value="&lt;b&gt;source&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="788" width="110" height="36" as="geometry"/></mxCell><mxCell id="v76" value="копия совпала с диском (imageio /checksum)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1076" y="788" width="480" height="36" as="geometry"/></mxCell><mxCell id="v77" value="сразу после бэкапа" style="rounded=1;html=1;fillColor=#fff8e1;strokeColor=#bdbdbd;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1562" y="788" width="150" height="36" as="geometry"/></mxCell><mxCell id="v78" value="&lt;b&gt;manifest&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="832" width="110" height="36" as="geometry"/></mxCell><mxCell id="v79" value="SHA-256 каждого чанка сходится с манифестом" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1076" y="832" width="480" height="36" as="geometry"/></mxCell><mxCell id="v80" value="читает всю копию" style="rounded=1;html=1;fillColor=#fff3e0;strokeColor=#bdbdbd;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1562" y="832" width="150" height="36" as="geometry"/></mxCell><mxCell id="v81" value="&lt;b&gt;restore&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="876" width="110" height="36" as="geometry"/></mxCell><mxCell id="v82" value="образ собирается из цепочки, сумма сходится" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1076" y="876" width="480" height="36" as="geometry"/></mxCell><mxCell id="v83" value="читает и собирает" style="rounded=1;html=1;fillColor=#ffe0b2;strokeColor=#bdbdbd;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1562" y="876" width="150" height="36" as="geometry"/></mxCell><mxCell id="v84" value="&lt;b&gt;qemu&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="920" width="110" height="36" as="geometry"/></mxCell><mxCell id="v85" value="qemu-img check экспортированного qcow2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1076" y="920" width="480" height="36" as="geometry"/></mxCell><mxCell id="v86" value="нужен qemu-img" style="rounded=1;html=1;fillColor=#ffe0b2;strokeColor=#bdbdbd;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1562" y="920" width="150" height="36" as="geometry"/></mxCell><mxCell id="v87" value="&lt;b&gt;structure&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="964" width="110" height="36" as="geometry"/></mxCell><mxCell id="v88" value="в образе есть таблица разделов и суперблоки ФС" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1076" y="964" width="480" height="36" as="geometry"/></mxCell><mxCell id="v89" value="начало образа" style="rounded=1;html=1;fillColor=#fff3e0;strokeColor=#bdbdbd;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1562" y="964" width="150" height="36" as="geometry"/></mxCell><mxCell id="v90" value="&lt;b&gt;boot&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="1008" width="110" height="36" as="geometry"/></mxCell><mxCell id="v91" value="гость поднялся, отозвался агент" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1076" y="1008" width="480" height="36" as="geometry"/></mxCell><mxCell id="v92" value="самое дорогое" style="rounded=1;html=1;fillColor=#ffcdd2;strokeColor=#bdbdbd;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1562" y="1008" width="150" height="36" as="geometry"/></mxCell><mxCell id="v93" value="🔒 structure ловит «цел побайтово, но внутри пусто»" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1718" y="964" width="130" height="36" as="geometry"/></mxCell><mxCell id="v94" value="🔒 boot: ВМ без единого сетевого интерфейса" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1718" y="1008" width="130" height="36" as="geometry"/></mxCell><mxCell id="v95" value="🔒 проверка после бэкапа хранится в задании (verify_options); тяжёлые проверки ограничены backup.heavy_workers, пробный запуск проверяет свободное место на гипервизоре" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="960" y="1060" width="888" height="36" as="geometry"/></mxCell><mxCell id="v96" value="Контрольные суммы доказывают точность копии, а не осмысленность содержимого — поэтому режимы дополняют друг друга." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="1102" width="888" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p9" name="9. Восстановление"><mxGraphModel dx="1880" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" value="Схема" parent="0"/><mxCell id="sec" value="Защита" parent="0"/><mxCell id="v1" value="9. Восстановление: от точки к образу, диску или новой машине" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1820" height="34" as="geometry"/></mxCell><mxCell id="v2" value="Цепочка всегда читается из одного физического хранилища и проверяется по SHA-256 каждого чанка по пути в цель. Межплатформенной конвертации нет: oVirt → oVirt, KVM → KVM, Proxmox → Proxmox." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1820" height="40" as="geometry"/></mxCell><mxCell id="v3" value="Откуда" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="300" height="700" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;Точка восстановления&lt;/b&gt;&lt;br&gt;backup_runs, выбор в интерфейсе&lt;br&gt;или через API" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="260" height="70" as="geometry"/></mxCell><mxCell id="v5" value="основное хранилище" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="220" height="50" as="geometry"/></mxCell><mxCell id="v6" value="реплика 1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="220" height="50" as="geometry"/></mxCell><mxCell id="v7" value="реплика 2" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="220" height="50" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Одно хранилище на всю цепочку&lt;/b&gt;&lt;br&gt;звенья из разных хранилищ&lt;br&gt;не смешиваются" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="260" height="80" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v11" value="🔒 право backups.write; каждая операция — в журнал аудита и restore_runs (фаза, прогресс, ошибка)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="40" y="590" width="260" height="56" as="geometry"/></mxCell><mxCell id="v12" value="🔒 heavy_workers ограничивает одновременные восстановления и проверки" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="40" y="652" width="260" heig