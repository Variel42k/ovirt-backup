#!/usr/bin/env bash
# jhvirt-db-dump — хелпер логических дампов СУБД для службы копий jhvirt.
#
# Ставится на хост СУБД и запускается только как forced command:
#
#   restrict,command="/usr/local/sbin/jhvirt-db-dump" ssh-ed25519 AAAA… jhvirt
#
# в ~/.ssh/authorized_keys отдельного системного пользователя (по умолчанию
# jhvirt_dump). Root хелперу не нужен: в СУБД он входит от имени этого же
# пользователя через Unix-сокет (peer в PostgreSQL, unix_socket/auth_socket в
# MariaDB и MySQL), поэтому паролей СУБД нет ни здесь, ни в службе копий.
#
# Протокол jhvirt-db-dump/1 — фиксированный набор операций:
#   probe                       версия протокола и доступные СУБД
#   list ENGINE                 базы, по одной в строке
#   stats ENGINE                read-only счётчики транзакций и журнала
#   dump ENGINE DB              дамп одной базы в stdout
#   globals postgresql          роли и табличные пространства без хешей паролей
#   restore ENGINE NEWDB        восстановление из stdin в НОВУЮ базу (выключено
#                               по умолчанию, см. JHVIRT_DB_ALLOW_RESTORE)
# ENGINE — postgresql или mysql (MySQL и MariaDB). Операции удаления или
# перезаписи существующей базы в протоколе нет.
#
# СУБД в Kubernetes. Если в настройках задано JHVIRT_K8S_NAMESPACE, клиенты
# СУБД запускаются не на хосте, а в контейнере пода через kubectl exec: хост
# хелпера — любая машина с kubectl (узел управления, бастион), под может
# работать на любом узле. Пароль, если нужен, берётся из окружения самого
# контейнера (JHVIRT_K8S_PASSWORD_ENV) и хелперу не передаётся. Права
# учётной записи kubectl: get/list pods и create pods/exec в одном
# пространстве имён — см. k8s-rbac.yaml рядом.
#
# Профили. Сначала читается /etc/jhvirt/db-dump.conf, затем
# /etc/jhvirt/db-dump.d/ИМЯ_ПОЛЬЗОВАТЕЛЯ.conf. Профиль выбирает SSH-вход, а не
# клиент: так один хост обслуживает несколько баз (например, на хосте и в
# двух пространствах имён кластера) под разными ключами службы.
set -Eeuo pipefail

PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
export PATH

PROTOCOL=jhvirt-db-dump/1
CONF=/etc/jhvirt/db-dump.conf
NAME_RE='^[A-Za-z0-9_][A-Za-z0-9_.-]{0,62}$'

fail() {
    printf 'jhvirt-db-dump: %s\n' "$*" >&2
    exit 64
}

# Со forced command sshd запускает хелпер без аргументов и кладёт запрос в
# SSH_ORIGINAL_COMMAND. Слова разбираются только после проверки всей строки
# на алфавит без пробелов внутри слов и метасимволов оболочки.
if [[ $# -eq 0 && -n "${SSH_ORIGINAL_COMMAND:-}" ]]; then
    [[ "$SSH_ORIGINAL_COMMAND" =~ ^(/usr/local/sbin/)?jhvirt-db-dump(\ [A-Za-z0-9_.=-]+)+$ ]] ||
        fail "invalid forced command"
    IFS=' ' read -r -a original <<<"$SSH_ORIGINAL_COMMAND"
    set -- "${original[@]:1}"
fi

[[ ${EUID} -ne 0 ]] || fail "run the helper as a dedicated unprivileged user, not root"

# Настройки — только из файла root, недоступного на запись другим: хелпер
# выполняет его как shell-код.
JHVIRT_DB_ALLOW_RESTORE=0
JHVIRT_PG_HOST=
JHVIRT_PG_PORT=
JHVIRT_PG_MAINTENANCE_DB=postgres
JHVIRT_MYSQL_DEFAULTS_FILE=
JHVIRT_DB_EXCLUDE=
JHVIRT_K8S_NAMESPACE=
JHVIRT_K8S_POD=
JHVIRT_K8S_SELECTOR=
JHVIRT_K8S_CONTAINER=
JHVIRT_K8S_DB_USER=
JHVIRT_K8S_PASSWORD_ENV=
JHVIRT_KUBECTL=kubectl
JHVIRT_KUBECONFIG=

# load_conf FILE читает настройки, если файл принадлежит root и недоступен на
# запись другим: хелпер выполняет его как shell-код.
load_conf() {
    [[ "$(stat -c '%u' "$1")" == 0 ]] || fail "$1 must be owned by root"
    (( (8#$(stat -c '%a' "$1") & 8#022) == 0 )) || fail "$1 must not be writable by group or others"
    # shellcheck disable=SC1090
    . "$1"
}

if [[ -e "$CONF" ]]; then
    load_conf "$CONF"
elif [[ -d "${CONF%/*}" && ! -x "${CONF%/*}" ]]; then
    # Недоступный каталог выглядит как отсутствие файла: хелпер молча работал
    # бы со значениями по умолчанию и, например, считал восстановление
    # выключенным. Лучше явная ошибка.
    fail "${CONF%/*} is not accessible to $(id -un): chmod 0755 ${CONF%/*}"
fi
PROFILE="${CONF%/*}/db-dump.d/$(id -un).conf"
[[ ! -e "$PROFILE" ]] || load_conf "$PROFILE"

K8S_NAME_RE='^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$'
K8S_SELECTOR_RE='^[A-Za-z0-9_./=,!-]+$'
ENV_RE='^[A-Za-z_][A-Za-z0-9_]{0,63}$'
K8S=0
if [[ -n "$JHVIRT_K8S_NAMESPACE" ]]; then
    K8S=1
    [[ "$JHVIRT_K8S_NAMESPACE" =~ $K8S_NAME_RE ]] || fail "JHVIRT_K8S_NAMESPACE is not a valid name"
    [[ "$JHVIRT_K8S_CONTAINER" =~ $K8S_NAME_RE ]] || fail "JHVIRT_K8S_CONTAINER is required"
    [[ -z "$JHVIRT_K8S_POD" || "$JHVIRT_K8S_POD" =~ $K8S_NAME_RE ]] || fail "JHVIRT_K8S_POD is not a valid name"
    [[ -n "$JHVIRT_K8S_POD" || "$JHVIRT_K8S_SELECTOR" =~ $K8S_SELECTOR_RE ]] ||
        fail "set JHVIRT_K8S_POD or JHVIRT_K8S_SELECTOR"
    [[ -z "$JHVIRT_K8S_PASSWORD_ENV" || "$JHVIRT_K8S_PASSWORD_ENV" =~ $ENV_RE ]] ||
        fail "JHVIRT_K8S_PASSWORD_ENV is not a valid variable name"
    [[ -z "$JHVIRT_K8S_DB_USER" || "$JHVIRT_K8S_DB_USER" =~ $NAME_RE ]] || fail "JHVIRT_K8S_DB_USER is not a valid name"
    read -r -a kubectl <<<"$JHVIRT_KUBECTL"
    [[ -z "$JHVIRT_KUBECONFIG" ]] || kubectl+=(--kubeconfig="$JHVIRT_KUBECONFIG")
    kubectl+=(--namespace="$JHVIRT_K8S_NAMESPACE")
fi

# k8s_pod находит под с СУБД: заданный явно или первый работающий по
# селектору. Если экземпляров несколько, селектор должен выбирать ведущий
# (например, cnpg.io/instanceRole=primary или role=master). Результат
# запоминается в POD, поэтому первый вызов делается не в подоболочке.
POD=
k8s_pod() {
    [[ -z "$POD" ]] || return 0
    if [[ -n "$JHVIRT_K8S_POD" ]]; then
        POD=$JHVIRT_K8S_POD
        return 0
    fi
    POD=$("${kubectl[@]}" get pods --selector="$JHVIRT_K8S_SELECTOR" \
        --field-selector=status.phase=Running \
        --output='jsonpath={.items[0].metadata.name}' </dev/null) ||
        fail "kubectl get pods failed in namespace $JHVIRT_K8S_NAMESPACE"
    [[ -n "$POD" ]] || fail "no running pod matches $JHVIRT_K8S_SELECTOR in $JHVIRT_K8S_NAMESPACE"
    [[ "$POD" =~ $K8S_NAME_RE ]] || fail "kubectl returned an unexpected pod name"
}

# Скрипт в контейнере: пароль — из окружения самого контейнера, затем
# запуск клиента СУБД с переданными аргументами.
# shellcheck disable=SC2016
IN_POD='
if [ -n "$1" ]; then
    v=$(printenv "$1") || { echo "jhvirt-db-dump: no variable $1 in the container" >&2; exit 64; }
    PGPASSWORD=$v MYSQL_PWD=$v
    export PGPASSWORD MYSQL_PWD
fi
shift
exec "$@"'

# db TOOL ARGS... запускает клиент СУБД: на хосте или в контейнере пода.
# Стандартный ввод уходит в контейнер только у db_stdin (restore): иначе
# kubectl держал бы канал SSH открытым.
db() {
    if [[ "$K8S" == 0 ]]; then
        "$@"
        return
    fi
    k8s_pod
    "${kubectl[@]}" exec "$POD" --container="$JHVIRT_K8S_CONTAINER" -- \
        sh -c "$IN_POD" jhvirt "$JHVIRT_K8S_PASSWORD_ENV" "$@" </dev/null
}

db_stdin() {
    if [[ "$K8S" == 0 ]]; then
        "$@"
        return
    fi
    k8s_pod
    "${kubectl[@]}" exec --stdin "$POD" --container="$JHVIRT_K8S_CONTAINER" -- \
        sh -c "$IN_POD" jhvirt "$JHVIRT_K8S_PASSWORD_ENV" "$@"
}

# has_tool NAME — есть ли программа там, где работает СУБД.
has_tool() {
    if [[ "$K8S" == 0 ]]; then
        command -v "$1" >/dev/null 2>&1
    else
        # shellcheck disable=SC2016
        db sh -c 'command -v "$0"' "$1" >/dev/null 2>&1
    fi
}

# first_tool NAME... печатает первую найденную программу.
first_tool() {
    local tool
    for tool in "$@"; do
        if has_tool "$tool"; then
            printf '%s\n' "$tool"
            return 0
        fi
    done
    return 0
}

pg_args=()
[[ -z "$JHVIRT_PG_HOST" ]] || pg_args+=(--host="$JHVIRT_PG_HOST")
[[ -z "$JHVIRT_PG_PORT" ]] || pg_args+=(--port="$JHVIRT_PG_PORT")
# В контейнере peer-входа от пользователя хелпера нет: роль задаётся явно.
[[ "$K8S" == 0 ]] || pg_args+=(--username="${JHVIRT_K8S_DB_USER:-postgres}")

mysql_client() { first_tool mariadb mysql; }
mysql_dumper() { first_tool mariadb-dump mysqldump; }
my_args=()
if [[ "$K8S" == 0 ]]; then
    [[ -z "$JHVIRT_MYSQL_DEFAULTS_FILE" ]] || my_args+=(--defaults-extra-file="$JHVIRT_MYSQL_DEFAULTS_FILE")
else
    # Файл параметров лежит на хосте хелпера и контейнеру не виден.
    my_args+=(--user="${JHVIRT_K8S_DB_USER:-root}")
fi
my_args+=(--protocol=socket)

# Под находится один раз до разбора операции: в подоболочках $(...) найденное
# имя не сохранилось бы, и kubectl get pods выполнялся бы на каждый запрос.
[[ "$K8S" == 0 ]] || k8s_pod

check_engine() {
    [[ "$1" == postgresql || "$1" == mysql ]] || fail "unknown engine: $1"
}

check_name() {
    [[ "$1" =~ $NAME_RE ]] || fail "invalid database name"
}

# system_db сообщает, что базу нельзя ни снимать как пользовательскую, ни
# создавать при восстановлении.
system_db() {
    case "$1:$2" in
    postgresql:template0 | postgresql:template1) return 0 ;;
    mysql:information_schema | mysql:performance_schema | mysql:sys | mysql:mysql) return 0 ;;
    esac
    return 1
}

excluded() {
    local item
    for item in $JHVIRT_DB_EXCLUDE; do
        [[ "$item" == "$1" ]] && return 0
    done
    return 1
}

psql_q() {
    db psql "${pg_args[@]}" --no-psqlrc --no-password --quiet --tuples-only --no-align \
        --set=ON_ERROR_STOP=1 --dbname="$JHVIRT_PG_MAINTENANCE_DB" "$@"
}

mysql_q() {
    local client
    client=$(mysql_client)
    [[ -n "$client" ]] || fail "mysql/mariadb client is not installed"
    db "$client" "${my_args[@]}" --batch --skip-column-names "$@" </dev/null
}

action="${1:-}"
case "$action" in
probe)
    [[ $# -eq 1 ]] || fail "probe takes no arguments"
    printf '%s\n' "$PROTOCOL"
    if has_tool pg_dump; then
        if version=$(psql_q --command='SHOW server_version' 2>&1); then
            printf 'engine postgresql %s\n' "${version%%[[:space:]]*}"
        else
            printf 'error postgresql %s\n' "$(printf '%s' "$version" | head -n 1 | tr -c '[:print:]' ' ')"
        fi
    fi
    if [[ -n "$(mysql_dumper)" ]]; then
        if version=$(mysql_q --execute='SELECT VERSION()' 2>&1); then
            printf 'engine mysql %s\n' "${version%%[[:space:]]*}"
        else
            printf 'error mysql %s\n' "$(printf '%s' "$version" | head -n 1 | tr -c '[:print:]' ' ')"
        fi
    fi
    printf 'restore %s\n' "$([[ "$JHVIRT_DB_ALLOW_RESTORE" == 1 ]] && echo enabled || echo disabled)"
    ;;

list)
    [[ $# -eq 2 ]] || fail "usage: list ENGINE"
    check_engine "$2"
    if [[ "$2" == postgresql ]]; then
        names=$(psql_q --command='SELECT datname FROM pg_database WHERE datallowconn AND NOT datistemplate ORDER BY 1')
    else
        names=$(mysql_q --execute='SHOW DATABASES')
    fi
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        system_db "$2" "$name" && continue
        excluded "$name" && continue
        # Базы с именами вне алфавита протокола пропускаются явно: служба не
        # сможет запросить их дамп, и молча терять их из списка хуже.
        if [[ "$name" =~ $NAME_RE ]]; then
            printf '%s\n' "$name"
        else
            printf 'jhvirt-db-dump: skipping database with unsupported name\n' >&2
        fi
    done <<<"$names"
    ;;

stats)
    [[ $# -eq 2 ]] || fail "usage: stats ENGINE"
    check_engine "$2"
    if [[ "$2" == postgresql ]]; then
        values=$(psql_q --field-separator=' ' --command="SELECT COALESCE(sum(xact_commit),0), COALESCE(sum(xact_rollback),0), COALESCE(sum(numbackends),0), pg_wal_lsn_diff(pg_current_wal_lsn(),'0/0')::bigint FROM pg_stat_database")
    else
        values=$(mysql_q --execute="SELECT COALESCE(MAX(CASE WHEN VARIABLE_NAME='Com_commit' THEN VARIABLE_VALUE END),0), COALESCE(MAX(CASE WHEN VARIABLE_NAME='Com_rollback' THEN VARIABLE_VALUE END),0), COALESCE(MAX(CASE WHEN VARIABLE_NAME='Threads_running' THEN VARIABLE_VALUE END),0), COALESCE(MAX(CASE WHEN VARIABLE_NAME='Innodb_os_log_written' THEN VARIABLE_VALUE END),0) FROM performance_schema.global_status")
    fi
    values=$(printf '%s' "$values" | tr '\t' ' ' | tr -s '[:space:]' ' ')
    [[ "$values" =~ ^[[:space:]]*[0-9]+\ [0-9]+\ [0-9]+\ [0-9]+[[:space:]]*$ ]] || fail "database returned invalid counters"
    printf 'jhvirt-db-stats/1 %s %s\n' "$2" "$values"
    ;;

dump)
    [[ $# -eq 3 ]] || fail "usage: dump ENGINE DB"
    check_engine "$2"
    check_name "$3"
    system_db "$2" "$3" && fail "system database cannot be dumped"
    if [[ "$2" == postgresql ]]; then
        # Формат custom: сжатие отключено, его сделает служба вместе с
        # шифрованием; pg_restore умеет выборочное восстановление.
        db pg_dump "${pg_args[@]}" --no-password --format=custom --compress=0 --dbname="$3"
        exit
    fi
    dumper=$(mysql_dumper)
    [[ -n "$dumper" ]] || fail "mysqldump/mariadb-dump is not installed"
    # --single-transaction даёт согласованный снимок InnoDB без блокировки
    # записи; таблицы MyISAM читаются без снимка.
    db "$dumper" "${my_args[@]}" --single-transaction --quick --routines --events --triggers \
        --hex-blob --no-tablespaces --default-character-set=utf8mb4 "$3" </dev/null
    ;;

globals)
    [[ $# -eq 2 && "$2" == postgresql ]] || fail "usage: globals postgresql"
    # Без хешей паролей: восстановленные роли получают пароли заново.
    db pg_dumpall "${pg_args[@]}" --no-password --globals-only --no-role-passwords
    ;;

restore)
    [[ $# -eq 3 ]] || fail "usage: restore ENGINE NEWDB"
    check_engine "$2"
    check_name "$3"
    [[ "$JHVIRT_DB_ALLOW_RESTORE" == 1 ]] || fail "restore is disabled on this host (JHVIRT_DB_ALLOW_RESTORE=1 in $CONF)"
    system_db "$2" "$3" && fail "cannot restore into a system database"
    db="$3"
    created=0
    cleanup() {
        [[ "$created" == 1 ]] || return 0
        # Удаляется только база, созданная этим же вызовом.
        if [[ "$2" == postgresql ]]; then
            psql_q --command="DROP DATABASE IF EXISTS \"$db\"" >/dev/null 2>&1 || true
        else
            mysql_q --execute="DROP DATABASE IF EXISTS \`$db\`" >/dev/null 2>&1 || true
        fi
    }
    trap 'cleanup "$@"' ERR HUP INT TERM
    if [[ "$2" == postgresql ]]; then
        # CREATE DATABASE завершится ошибкой, если база уже есть: существующая
        # база никогда не перезаписывается.
        psql_q --command="CREATE DATABASE \"$db\"" >/dev/null
        created=1
        db_stdin pg_restore "${pg_args[@]}" --no-password --no-owner --no-privileges --exit-on-error --dbname="$db"
    else
        mysql_q --execute="CREATE DATABASE \`$db\`" >/dev/null
        created=1
        client=$(mysql_client)
        db_stdin "$client" "${my_args[@]}" --batch "$db"
    fi
    created=0
    trap - ERR HUP INT TERM
    printf 'restored %s\n' "$db"
    ;;

*) fail "unknown action" ;;
esac
