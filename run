#!/bin/sh
# Единая точка входа для работы с проектом: ./run <команда>
#
# Одна команда вместо make, набора скриптов и запоминания флагов go build.
# POSIX sh: make отсутствует в стандартной установке Windows и в минимальных
# образах CI, а собирать и проверять проект должно быть можно везде, где есть
# Go и Node.
#
# ./run без аргументов покажет список команд.

set -eu

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

die() { printf 'ошибка: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }
step() { printf '\n==> %s\n' "$*"; }

need() {
    command -v "$1" >/dev/null 2>&1 || die "не найден $1 — $2"
}

# Файлы Go без веб-каталога: gofmt не должен трогать чужие зависимости.
go_files() {
    find . -name '*.go' -not -path './web/*' -not -path './dist/*'
}

# Версия из git, иначе dev. Суффикс -dirty оставляем видимым: он означает
# несохранённые правки, и «та самая сборка» не должна путаться с похожей.
version() {
    if [ -n "${JHV_VERSION:-}" ]; then
        printf '%s\n' "$JHV_VERSION"
    elif command -v git >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1; then
        git describe --tags --always --dirty 2>/dev/null || echo dev
    else
        echo dev
    fi
}

# --- Команды ----------------------------------------------------------------

cmd_help() {
    cat <<'EOF'
ovirt-backup — команды разработки и сборки

  ./run build [ключи]   собрать комплект для переноса на сервер
  ./run dev             запустить сервер (:8080) с конфигурацией по умолчанию
  ./run web             запустить интерфейс в режиме разработки (:9000)

  ./run test [-race]    тесты Go (базу для них поднимает сам)
  ./run test-db …       start|stop|status временной базы для тестов
  ./run race            тесты с детектором гонок (в контейнере, нужен docker)
  ./run check           формат, go vet, тесты, проверка типов интерфейса
  ./run fmt             отформатировать код

  ./run sbom            состав зависимостей в формате CycloneDX
  ./run vuln            поиск уязвимостей: govulncheck, grype, trivy

  ./run docker          собрать docker-образ
  ./run version         показать версию, из которой соберётся бинарь
  ./run clean           удалить артефакты сборки

Ключи build:
  --target ос/арх       кросс-сборка, например linux/amd64 или linux/arm64
  --version X.Y.Z       явная версия вместо взятой из git
  --skip-web            только бинари; web/dist должен быть собран заранее
  --tar                 оставить рядом и обычный tar.gz
  --no-archive          разложить в dist/, не паковать

Примеры:
  ./run build --target linux/amd64
  ./run check
  ./run test -race

build даёт один файл dist/ovirt-backup-<версия>-<ос>-<арх>.run: скрипт с архивом
внутри. Копируется на сервер и запускается — распаковка и установка внутри.

  scp dist/ovirt-backup-*.run server:/tmp/ && ssh server 'sudo sh /tmp/ovirt-backup-*.run'
EOF
}

cmd_version() { version; }

cmd_fmt() {
    need gofmt "он идёт вместе с Go"
    step "форматирование Go"
    # shellcheck disable=SC2046
    gofmt -w -s $(go_files)
    say "готово"
}

cmd_vet() {
    need go "нужен Go 1.26+ (https://go.dev/dl/)"
    step "go vet"
    go vet ./...
    say "замечаний нет"
}

# Имя и порт временной базы для тестов. Порт нестандартный: 5432 на машине
# разработчика обычно уже занят своей PostgreSQL, и тесты не должны ни
# конфликтовать с ней, ни тем более в неё писать.
TEST_PG_NAME="jhvirt-test-pg"
TEST_PG_PORT="${JHV_TEST_PG_PORT:-55432}"

# Поднимает временную PostgreSQL для тестов хранилища и печатает строку
# подключения. Контейнер переиспользуется между прогонами: ждать старта базы
# каждый раз — минус несколько секунд на каждый запуск тестов.
start_test_pg() {
    if ! command -v docker >/dev/null 2>&1; then
        return 1
    fi
    if ! docker inspect "$TEST_PG_NAME" >/dev/null 2>&1; then
        docker run -d --name "$TEST_PG_NAME" \
            -p "$TEST_PG_PORT:5432" \
            -e POSTGRES_USER=jhvirt -e POSTGRES_PASSWORD=jhvirt -e POSTGRES_DB=jhvirt_test \
            docker.io/library/postgres:17-alpine >/dev/null 2>&1 || return 1
    elif [ "$(docker inspect -f '{{.State.Running}}' "$TEST_PG_NAME" 2>/dev/null)" != "true" ]; then
        docker start "$TEST_PG_NAME" >/dev/null 2>&1 || return 1
    fi

    i=0
    while [ "$i" -lt 30 ]; do
        if docker exec "$TEST_PG_NAME" pg_isready -U jhvirt -q >/dev/null 2>&1; then
            printf 'host=localhost port=%s user=jhvirt password=jhvirt dbname=jhvirt_test sslmode=disable\n' "$TEST_PG_PORT"
            return 0
        fi
        i=$((i + 1))
        sleep 1
    done
    return 1
}

cmd_test() {
    need go "нужен Go 1.26+"

    # Тестам хранилища нужна настоящая PostgreSQL: подменять её на что-то
    # попроще значит проверять не то, что работает в бою.
    if [ -z "${JHV_TEST_POSTGRES_DSN:-}" ]; then
        step "временная база для тестов"
        if DSN="$(start_test_pg)"; then
            export JHV_TEST_POSTGRES_DSN="$DSN"
            say "    $TEST_PG_NAME на порту $TEST_PG_PORT (остановить: ./run test-db stop)"
        else
            say "    не удалось поднять — тесты хранилища будут пропущены с ошибкой"
            say "    задайте JHV_TEST_POSTGRES_DSN вручную, если база есть"
        fi
    fi

    if [ "${1:-}" = "-race" ]; then
        step "тесты с детектором гонок"
        # -race — единственное место, где нужен cgo: детектор реализован в
        # рантайме на C. Сам проект собирается без него.
        CGO_ENABLED=1 go test -race ./... || die \
            "если сообщение про cgo — нужен компилятор C; без -race тесты пройдут"
    else
        step "тесты"
        go test ./...
    fi
}

# Управление временной базой: она живёт между прогонами, и её должно быть чем
# убрать, не вспоминая имя контейнера.
cmd_test_db() {
    case "${1:-status}" in
        start)
            DSN="$(start_test_pg)" || die "не удалось поднять базу (нужен docker)"
            say "$DSN"
            ;;
        stop)
            docker rm -f "$TEST_PG_NAME" >/dev/null 2>&1 || true
            say "временная база остановлена и удалена"
            ;;
        status)
            if docker inspect -f '{{.State.Status}}' "$TEST_PG_NAME" 2>/dev/null; then :; else
                say "не запущена"
            fi
            ;;
        *) die "./run test-db start|stop|status" ;;
    esac
}

# Кэши Go для контейнерных прогонов.
#
# Именованные тома, а не каталоги на хосте: под Windows проброс каталога идёт
# через слой трансляции, и запись сотен тысяч мелких файлов в него медленнее
# самой сборки. Без кэшей каждый прогон заново скачивал зависимости и
# компилировал всё с нуля — около двух минут на команду, которую после этого
# перестают запускать.
RACE_MOD_CACHE="jhvirt-gomod"
RACE_BUILD_CACHE="jhvirt-gobuild"

# Образ должен совпадать по версии Go с go.mod: детектор гонок собирает проект
# заново, и расхождение версий проявилось бы как «локально проходит, а в
# контейнере нет».
RACE_IMAGE="docker.io/library/golang:1.27"

# host_to_container переписывает адрес базы так, чтобы он был виден изнутри
# контейнера: localhost там указывает на сам контейнер.
#
# Обе формы строки подключения: libpq (host=…) и URL (…@localhost:5432/…).
# Первой хватило бы — её печатает ./run test-db, — но JHV_TEST_POSTGRES_DSN
# задаёт человек и вполне может дать URL, а молчаливый отказ подключиться
# изнутри контейнера объяснить потом трудно.
host_to_container() {
    printf '%s' "$1" |
        sed -e 's/host=localhost/host=host.docker.internal/g' \
            -e 's/host=127[.]0[.]0[.]1/host=host.docker.internal/g' \
            -e 's/@localhost:/@host.docker.internal:/g' \
            -e 's/@127[.]0[.]0[.]1:/@host.docker.internal:/g'
}

# Детектор гонок в контейнере.
#
# Ему нужны CGO_ENABLED=1 и компилятор C, которых на машине разработчика под
# Windows обычно нет. Образ golang приносит их с собой, поэтому прогон доступен
# всем, а не только тем, кто настроил toolchain.
#
# Аргументы docker собираются через set --, а не пишутся одной строкой с
# переносами: перенос строки в этом файле переживает не всякий способ его
# правки, и однажды уже схлопнулся в неразборчивую строку на сто символов.
cmd_race() {
    need docker "нужен Docker: детектору гонок нужен компилятор C"

    DSN="${JHV_TEST_POSTGRES_DSN:-}"
    if [ -z "$DSN" ]; then
        step "временная база для тестов"
        DSN="$(start_test_pg)" || die "не удалось поднять базу"
        say "    $TEST_PG_NAME на порту $TEST_PG_PORT"
    fi

    set -- docker run --rm
    set -- "$@" -v "$(pwd -W 2>/dev/null || pwd):/src" -w /src
    set -- "$@" -v "$RACE_MOD_CACHE:/go/pkg/mod"
    set -- "$@" -v "$RACE_BUILD_CACHE:/root/.cache/go-build"
    set -- "$@" -e "JHV_TEST_POSTGRES_DSN=$(host_to_container "$DSN")"
    set -- "$@" --add-host=host.docker.internal:host-gateway
    set -- "$@" "$RACE_IMAGE" go test -race -count=1 ./...

    step "тесты с детектором гонок ($RACE_IMAGE)"
    # Git Bash автоматически превращает контейнерный /src в путь установки
    # Git for Windows. Хостовый bind уже передан как Windows-путь через pwd -W,
    # поэтому для этого вызова преобразование аргументов нужно отключить.
    MSYS_NO_PATHCONV=1 "$@"
}

cmd_check() {
    cmd_fmt
    cmd_vet
    cmd_test
    if [ -d web/node_modules ]; then
        step "проверка типов интерфейса"
        (cd web && npm run typecheck)
    else
        say ""
        say "проверка типов пропущена: web/node_modules не установлены (npm --prefix web ci)"
    fi
    say ""
    say "всё чисто"
}

cmd_dev() {
    need go "нужен Go 1.26+"
    step "сервер на :8080 (Ctrl+C — остановить)"
    go run ./cmd/ovirt-backup-server -config config/ovirt-backup.yaml
}

cmd_web() {
    need npm "нужен Node 20+"
    [ -d web/node_modules ] || (cd web && npm install --no-audit --no-fund)
    step "интерфейс на :9000, /api проксируется на :8080"
    (cd web && npm run dev)
}

cmd_docker() {
    need docker "нужен Docker"
    V="$(version)"
    step "сборка образа ovirt-backup:$V"
    docker build --build-arg "VERSION=$V" -t "ovirt-backup:$V" .
    say "готово: ovirt-backup:$V"
}

# --- Состав зависимостей и уязвимости ---------------------------------------

# Версии инструментов закреплены намеренно. У сканера обновляется не только
# код, но и база правил, поэтому «последний» однажды красит вчера зелёную
# сборку, ничего не изменив в проекте. Версию поднимают отдельным решением,
# видя, что именно изменилось, — иначе разбираться приходится в тот момент,
# когда чинить надо совсем другое.
#
# Эти же значения читает CI: он вытаскивает их отсюда, чтобы проверка на
# машине разработчика и проверка в CI не разъехались молча.
SYFT_VERSION="v1.51.0"
GRYPE_VERSION="v0.117.0"
TRIVY_VERSION="v0.74.0"
GOVULNCHECK_VERSION="v1.7.0"

SBOM_DIR="dist/sbom"

# Запускает инструмент из PATH, а если его там нет — собирает go-модулем.
#
# Своих бинарей syft, grype и trivy здесь не скачивается: они раздаются
# релизами на GitHub, а он доступен не из всякой сети, где этот проект
# собирают. Через модульный прокси то же самое ставится везде, где уже
# работает `go mod download`, — то есть везде, где проект вообще собирается.
#
# Первый такой запуск занимает минуты: инструмент собирается из исходников.
# Дальше его забирает кэш сборки Go.
run_tool() {
    tool="$1"
    module="$2"
    shift 2
    if command -v "$tool" >/dev/null 2>&1; then
        "$tool" "$@"
    else
        go run "$module" "$@"
    fi
}

# trivy собирается отдельно от прочих, и не тем Go, что весь остальной проект.
#
# С версии 0.7x он использует encoding/json/v2. В Go 1.26 этот пакет был закрыт
# экспериментальным флагом, в Go 1.27 он открылся — но уже без SkipFunc, на
# который trivy опирается. Поэтому под 1.27 сборка падает на «undefined:
# json.SkipFunc», и GOEXPERIMENT тут не спасает: флаг стал пустышкой.
#
# Отсюда закреплённый GOTOOLCHAIN: trivy — отдельный модуль, и собрать его
# прежним Go можно, не трогая версию самого проекта. Нужный тулчейн Go скачает
# сам. Снять это закрепление можно, когда выйдет trivy под открытый json/v2;
# признак — сборка проходит без обеих переменных.
#
# На готовый бинарь из PATH это не влияет: он уже собран.
TRIVY_TOOLCHAIN="go1.26.6"
run_trivy() {
    if command -v trivy >/dev/null 2>&1; then
        trivy "$@"
    else
        GOTOOLCHAIN="$TRIVY_TOOLCHAIN" GOEXPERIMENT=jsonv2 \
            go run "github.com/aquasecurity/trivy/cmd/trivy@$TRIVY_VERSION" "$@"
    fi
}

# Имя собранного образа, если он есть. Пусто — образа нет.
built_image() {
    command -v docker >/dev/null 2>&1 || return 0
    IMG="ovirt-backup:$(version)"
    docker image inspect "$IMG" >/dev/null 2>&1 && printf '%s\n' "$IMG"
    return 0
}

cmd_sbom() {
    need go "нужен Go 1.26+"
    V="$(version)"
    mkdir -p "$SBOM_DIR"

    step "состав зависимостей исходников (CycloneDX)"
    # Каталог целиком, а не go.mod и package-lock.json по отдельности: так в
    # состав попадает и то, что лежит в дереве помимо объявленных зависимостей.
    #
    # node_modules исключены: их содержимое уже описано в package-lock.json, и
    # без исключения каждый пакет попадает в состав дважды.
    #
    # bin и dist — результат прошлой сборки, и исключены они не для скорости.
    # syft читает собранный бинарь и берёт версию stdlib из него, а не из
    # go.mod. Бинарь, собранный месяц назад прошлым Go, приносит в состав
    # исходников уязвимости того Go — которых в исходниках нет, а в следующей
    # сборке не будет и в бинаре. Состав от этого перестаёт быть
    # воспроизводимым: он зависит от того, что случайно осталось в каталоге.
    # Настоящую версию stdlib показывает состав образа, где бинарь собран
    # только что.
    run_tool syft "github.com/anchore/syft/cmd/syft@$SYFT_VERSION" \
        scan dir:. \
        --exclude './web/node_modules' \
        --exclude './bin' \
        --exclude './dist' \
        --exclude './web/dist' \
        --source-name ovirt-backup --source-version "$V" \
        -o "cyclonedx-json=$SBOM_DIR/source.cdx.json"
    say "    $SBOM_DIR/source.cdx.json"

    # Состав образа снимается отдельно. В нём есть то, чего нет в исходниках, —
    # alpine, qemu-img, ca-certificates, — и уязвимость приходит оттуда не реже,
    # чем из go.mod. По составу исходников её не видно вовсе.
    IMG="$(built_image)"
    if [ -n "$IMG" ]; then
        step "состав образа $IMG (CycloneDX)"
        run_tool syft "github.com/anchore/syft/cmd/syft@$SYFT_VERSION" \
            scan "docker:$IMG" \
            -o "cyclonedx-json=$SBOM_DIR/image.cdx.json"
        say "    $SBOM_DIR/image.cdx.json"
    else
        say ""
        say "состав образа пропущен: образа ovirt-backup:$V нет (соберёт ./run docker)"
    fi
}

cmd_vuln() {
    need go "нужен Go 1.26+"
    failed=""

    # govulncheck идёт первым и стоит особняком: он единственный смотрит не на
    # версию модуля, а на то, вызывается ли уязвимая функция вообще. Его
    # находка почти всегда настоящая, поэтому валит проверку любая.
    step "govulncheck — достижимость уязвимого кода"
    go run "golang.org/x/vuln/cmd/govulncheck@$GOVULNCHECK_VERSION" ./... ||
        failed="$failed govulncheck"

    # Состав снимается заново, если его нет или если появился образ, которого
    # не было в прошлый раз.
    if [ ! -f "$SBOM_DIR/source.cdx.json" ] ||
        { [ -n "$(built_image)" ] && [ ! -f "$SBOM_DIR/image.cdx.json" ]; }; then
        cmd_sbom
    fi

    # Порог high и только исправимое. Без этого список растёт за счёт того,
    # чего починить нельзя, к длинному списку привыкают и перестают читать — а
    # вместе с ним перестают замечать и то, что починить как раз можно.
    step "grype — объявленный состав исходников"
    run_tool grype "github.com/anchore/grype/cmd/grype@$GRYPE_VERSION" \
        "sbom:$SBOM_DIR/source.cdx.json" --fail-on high --only-fixed ||
        failed="$failed grype"

    # trivy держится рядом с grype намеренно: базы у них разные, и каждая
    # регулярно знает то, чего не знает вторая. Разница в минуту прогона.
    #
    # misconfig читает Dockerfile — оба, свой и bundle, — и находит то, чего не
    # найдёт ни один сканер пакетов: отсутствующий USER, лишние права, лишний
    # порт.
    #
    # docker-compose.yml он при этом не смотрит: среди его типов настроек
    # compose нет вовсе. Права контейнера, read_only и cap_drop заданы именно
    # там, и проверять их приходится глазами — на автоматику здесь
    # рассчитывать нельзя.
    step "trivy — зависимости, секреты, настройки сборки"
    # --no-progress: полоса загрузки рисуется возвратом каретки, а в журнале
    # CI, где каретки нет, от неё остаются сотни строк с процентами. Среди них
    # не видно ни находок, ни причины отказа.
    run_trivy \
        fs --scanners vuln,secret,misconfig --no-progress \
        --ignore-unfixed --severity HIGH,CRITICAL --exit-code 1 \
        --skip-dirs web/node_modules --skip-dirs bin --skip-dirs dist \
        --skip-dirs web/dist \
        . || failed="$failed trivy"

    IMG="$(built_image)"
    if [ -n "$IMG" ]; then
        # Проверка образа не дополнительная, а основная. Полный состав есть
        # только у него: в дереве исходников объявлен 61 модуль, а в графе,
        # который попадает в бинарь, их около 280 — остальные транзитивные, и
        # по go.mod их не видно. Плюс сам базовый образ.
        step "grype — полный состав образа $IMG"
        run_tool grype "github.com/anchore/grype/cmd/grype@$GRYPE_VERSION" \
            "sbom:$SBOM_DIR/image.cdx.json" --fail-on high --only-fixed ||
            failed="$failed grype-image"

        step "trivy — образ $IMG"
        run_trivy \
            image --no-progress --ignore-unfixed --severity HIGH,CRITICAL \
            --exit-code 1 "$IMG" ||
            failed="$failed trivy-image"
    else
        say ""
        say "образа нет, проверен только объявленный состав (соберёт ./run docker)."
        say "весь граф модулей Go при этом всё равно прошёл через govulncheck,"
        say "непроверенным остаётся базовый образ: alpine, qemu-img, ca-certificates"
    fi

    say ""
    [ -z "$failed" ] || die "замечания нашли:$failed"
    say "уязвимостей уровня high и выше, для которых есть исправление, не найдено"
}

cmd_clean() {
    step "удаление артефактов"
    rm -rf bin dist web/dist coverage.out
    say "удалено: bin/ dist/ web/dist/ coverage.out"
    say "оставлено: web/node_modules (переустановка долгая; ./run clean-all уберёт и их)"
}

cmd_clean_all() {
    cmd_clean
    rm -rf web/node_modules
    say "удалено также: web/node_modules"

    # Тома с кэшами Go для ./run race и база для тестов: без этой уборки они
    # остаются в docker навсегда, а найти их потом можно только зная имена.
    if command -v docker >/dev/null 2>&1; then
        docker volume rm "$RACE_MOD_CACHE" "$RACE_BUILD_CACHE" >/dev/null 2>&1 || true
        docker rm -f "$TEST_PG_NAME" >/dev/null 2>&1 || true
        say "удалено также: тома кэшей Go и контейнер тестовой базы"
    fi
}

cmd_build() {
    TARGET=""; VERSION=""; SKIP_WEB=0; NO_ARCHIVE=0; KEEP_TAR=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --target)     TARGET="${2:-}"; shift 2 ;;
            --version)    VERSION="${2:-}"; shift 2 ;;
            --skip-web)   SKIP_WEB=1; shift ;;
            --no-archive) NO_ARCHIVE=1; shift ;;
            --tar)        KEEP_TAR=1; shift ;;
            *)            die "неизвестный ключ build: $1 (см. ./run help)" ;;
        esac
    done

    # Проверяем окружение до начала работы: узнать об отсутствии Node после
    # четырёх минут компиляции Go — потерянные четыре минуты.
    need go "нужен Go 1.26+ (https://go.dev/dl/)"
    [ "$SKIP_WEB" -eq 1 ] || need npm \
        "нужен Node 20+, либо соберите с --skip-web, если web/dist уже готов"

    [ -n "$VERSION" ] || VERSION="$(version)"

    if [ -n "$TARGET" ]; then
        GOOS="${TARGET%/*}"; GOARCH="${TARGET#*/}"
        [ "$GOOS" != "$TARGET" ] || die "цель задаётся как ос/арх, например linux/amd64"
    else
        GOOS="$(go env GOOS)"; GOARCH="$(go env GOARCH)"
    fi

    say "Go:      $(go env GOVERSION)"
    [ "$SKIP_WEB" -eq 1 ] || say "Node:    $(node --version 2>/dev/null || echo unknown)"
    say "версия:  $VERSION"
    say "цель:    $GOOS/$GOARCH"

    SUFFIX=""; [ "$GOOS" = "windows" ] && SUFFIX=".exe"
    NAME="ovirt-backup-$VERSION-$GOOS-$GOARCH"
    OUT="$ROOT/dist/$NAME"
    rm -rf "$OUT"
    mkdir -p "$OUT/bin" "$OUT/config" "$OUT/web" "$OUT/systemd" "$OUT/compose" "$OUT/docs"

    if [ "$SKIP_WEB" -eq 0 ]; then
        step "веб-интерфейс"
        if [ ! -d web/node_modules ]; then
            say "    зависимости не установлены, ставим"
            (cd web && npm ci --no-audit --no-fund) || \
                (cd web && npm install --no-audit --no-fund)
        fi
        (cd web && npm run build)
    else
        step "веб-интерфейс пропущен (--skip-web)"
    fi
    [ -f web/dist/index.html ] || die "нет web/dist/index.html — интерфейс не собран"

    # CGO_ENABLED=0 не оптимизация, а требование: бинарь должен быть статическим
    # и работать в любом поддерживаемом дистрибутиве независимо от версии libc.
    step "бинари"
    LDFLAGS="-s -w -X main.version=$VERSION"
    for c in ovirt-backup-server jvbackup; do
        CGO_ENABLED=0 GOOS="$GOOS" GOARCH="$GOARCH" \
            go build -trimpath -ldflags "$LDFLAGS" -o "$OUT/bin/$c$SUFFIX" "./cmd/$c"
        say "    $c$SUFFIX"
    done

    cp -r web/dist "$OUT/web/dist"
    cp config/ovirt-backup.yaml "$OUT/config/"
    cp deploy/install.sh "$OUT/install.sh"
	cp deploy/recover-admin.sh "$OUT/recover-admin.sh"
    cp deploy/systemd/jhvirt.service "$OUT/systemd/"
    cp deploy/systemd/jhvirt-dr-backup.service deploy/systemd/jhvirt-dr-backup.timer "$OUT/systemd/"
    cp deploy/dr-backup.sh "$OUT/systemd/"

    # Всё для установки в контейнерах. Dockerfile отдельный: он не собирает
    # проект, а берёт готовый бинарь и web/dist из этого же комплекта, поэтому
    # на сервере не нужны ни Go, ни Node, ни исходники.
    cp deploy/docker-compose.yml "$OUT/compose/"
    cp deploy/Dockerfile.keycloak "$OUT/compose/"
    cp deploy/Dockerfile.postgres "$OUT/compose/"
    cp deploy/dr-backup.sh "$OUT/compose/"
    cp deploy/.env.example "$OUT/compose/"
    # Dockerfile кладётся в корень комплекта, а не в compose/, чтобы пути
    # сборки совпадали с репозиторием: из compose/ контекст «..» — это корень
    # комплекта, ровно как из deploy/ это корень репозитория. Иначе
    # compose-файл пришлось бы править при упаковке, а расходящиеся копии
    # одного файла рано или поздно разъезжаются.
    cp deploy/Dockerfile.bundle "$OUT/Dockerfile"
    # Documentation evolves independently of the installer. A fixed allowlist
    # previously omitted new operational and security guides from the .run
    # bundle, leaving an installation with less documentation than the source.
    cp docs/*.md "$OUT/docs/"
    # В репозитории README ссылается на docs/X.md. Внутри комплекта он сам уже
    # находится в docs/, поэтому префикс убирается, чтобы ссылки не вели в
    # несуществующий docs/docs/.
    sed 's|](docs/|](|g' README.md > "$OUT/docs/README.md"
    printf '%s\n' "$VERSION" > "$OUT/VERSION"

    say ""
    if [ "$NO_ARCHIVE" -eq 1 ]; then
        say "готово: dist/$NAME/"
        return
    fi

    # Бинари пакуются отдельным проходом с явным режимом 0755: NTFS не хранит
    # бит исполнения, поэтому chmod при сборке из Windows ничего не даёт и на
    # сервере файл разворачивается неисполняемым. Права в комплекте не должны
    # зависеть от того, где его собирали.
    step "упаковка"
    (
        cd dist
        # Одной строкой намеренно: перенос строки здесь уже дважды не переживал
        # правку файла и превращался в аргумент tar с именем «n».
        tar cf "$NAME.tar" --exclude="$NAME/bin" --exclude="$NAME/install.sh" "$NAME"
        tar rf "$NAME.tar" --mode=0755 "$NAME/bin" "$NAME/install.sh"
        rm -f "$NAME.tar.gz"
        gzip -9 "$NAME.tar"
    )

    make_installer "$NAME" "$VERSION" "$GOOS/$GOARCH"

    if [ "$KEEP_TAR" -eq 1 ]; then
        say "    dist/$NAME.tar.gz (--tar)"
    else
        rm -f "dist/$NAME.tar.gz"
    fi

    say ""
    say "готово: dist/$NAME.run ($(du -h "dist/$NAME.run" 2>/dev/null | cut -f1 || echo '?'))"
    say ""
    say "Установка на сервере — один файл, распаковывать не нужно:"
    say "  scp dist/$NAME.run server:/tmp/"
    say "  ssh server 'sudo sh /tmp/$NAME.run'"
}

# Склеивает самораспаковывающийся установщик: текстовый заголовок, метка и
# сразу за ней tar.gz. Заголовок пишется с плейсхолдерами и подставляется
# через sed — с раскрытием переменных в heredoc пришлось бы экранировать в нём
# каждый $0, $@ и подстановку команды, а это ровно тот код, который потом
# ломается незаметно.
make_installer() {
    N="$1"; V="$2"; P="$3"

    SUM=""
    if command -v sha256sum >/dev/null 2>&1; then
        SUM="$(sha256sum "dist/$N.tar.gz" | cut -d' ' -f1)"
    elif command -v shasum >/dev/null 2>&1; then
        SUM="$(shasum -a 256 "dist/$N.tar.gz" | cut -d' ' -f1)"
    else
        say "    предупреждение: нет sha256sum, установщик не сможет проверить целостность"
    fi

    HDR="dist/.header.$$"
    cat > "$HDR" <<'HEADER_EOF'
#!/bin/sh
# ovirt-backup @VERSION@ (@PLATFORM@) — установщик в одном файле.
#
# Файл состоит из этого скрипта и приклеенного следом архива tar.gz. Скрипт
# находит начало архива по строке-метке, сверяет контрольную сумму,
# распаковывает во временный каталог и запускает установщик из комплекта.
# Временный каталог удаляется в любом случае, включая прерывание.
#
#   sudo sh ./@NAME@.run                установить или обновить
#   sudo sh ./@NAME@.run --uninstall    выбрать цель удаления
#   sudo sh ./@NAME@.run --uninstall=systemd|docker|all
#   sudo sh ./@NAME@.run --uninstall=all --remove-config
#   sudo sh ./@NAME@.run --migration-export /root/jhvirt-migration.tar.gz
#   sudo sh ./@NAME@.run --migrate-from /root/jhvirt-migration.tar.gz
#   sudo sh ./@NAME@.run --mode systemd --url https://host --tls self-signed
#   sh ./@NAME@.run --extract [каталог] только распаковать, не устанавливать
#   sh ./@NAME@.run --check             проверить целостность файла
#   sh ./@NAME@.run --version
#
# Переменные окружения передаются через sudo явным присваиванием:
#   sudo PREFIX=/srv/jhvirt sh ./@NAME@.run

set -eu

VERSION="@VERSION@"
PLATFORM="@PLATFORM@"
SHA256="@SHA256@"
NAME="@NAME@"

die() { printf 'ошибка: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

# Путь к самому себе: архив читается из этого же файла, а $0 при запуске
# «sh ./file.run» относительный.
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
[ -r "$SELF" ] || die "не могу прочитать себя: $SELF"

# Номер строки, с которой начинается архив. Читаем только начало файла:
# незачем прогонять четырнадцать мегабайт сжатых данных через awk. Метка
# ищется с якорем начала строки, поэтому упоминания её в комментариях выше
# не мешают.
payload_start() {
    head -n 200 "$SELF" | awk '/^__JHVIRT_ARCHIVE__$/ { print NR + 1; exit }'
}

payload() {
    OFFSET="$(payload_start)"
    [ -n "$OFFSET" ] || die "метка архива не найдена — файл повреждён или изменён"
    tail -n +"$OFFSET" "$SELF"
}

verify() {
    if [ -z "$SHA256" ]; then
        say "предупреждение: контрольная сумма не зашита, целостность не проверена"
        return 0
    fi
    if command -v sha256sum >/dev/null 2>&1; then
        ACTUAL="$(payload | sha256sum | cut -d' ' -f1)"
    elif command -v shasum >/dev/null 2>&1; then
        ACTUAL="$(payload | shasum -a 256 | cut -d' ' -f1)"
    else
        say "предупреждение: в системе нет sha256sum, целостность не проверена"
        return 0
    fi
    [ "$ACTUAL" = "$SHA256" ] || die "контрольная сумма не сошлась.
  ожидалось: $SHA256
  получено:  $ACTUAL
Скорее всего файл побился при копировании — перенесите его заново."
}

extract() {
    mkdir -p "$1"
    payload | tar xzf - -C "$1" || die "не удалось распаковать архив"
}

usage() {
    cat <<USAGE
ovirt-backup $VERSION ($PLATFORM) — установщик в одном файле.

  sudo sh ./$NAME.run                установить или обновить
  sudo sh ./$NAME.run --uninstall    выбрать цель удаления
  sudo sh ./$NAME.run --uninstall=systemd|docker|all
  sudo sh ./$NAME.run --uninstall=all --remove-config
  sudo sh ./$NAME.run --migration-export /root/jhvirt-migration.tar.gz
  sudo sh ./$NAME.run --migrate-from /root/jhvirt-migration.tar.gz
  sudo sh ./$NAME.run --mode systemd --url https://host --tls self-signed
  sh ./$NAME.run --extract [каталог] только распаковать, не устанавливать
  sh ./$NAME.run --check             проверить целостность файла
  sh ./$NAME.run --version

Переменные окружения передаются через sudo явным присваиванием:
  sudo PREFIX=/srv/jhvirt sh ./$NAME.run

Установщик сам готовит конфигурацию, запускает службу и ждёт
готовности, если не указан --no-start.
USAGE
}

case "${1:-}" in
    --version)  say "$VERSION ($PLATFORM)"; exit 0 ;;
    --help|-h)  usage; exit 0 ;;
    --check)    verify; say "целостность подтверждена: $VERSION ($PLATFORM)"; exit 0 ;;
    --extract)
        DEST="${2:-$PWD}"
        verify
        extract "$DEST"
        say "распаковано: $DEST/$NAME"
        say "установка:   sudo $DEST/$NAME/install.sh"
        exit 0 ;;
esac

# Несовпадение платформы ловим здесь: иначе оно всплывёт как «Exec format
# error» уже после установки, и связь с тем, что скопировали сборку под
# другую архитектуру, будет неочевидна.
case "$PLATFORM" in
    linux/amd64) WANT="x86_64" ;;
    linux/arm64) WANT="aarch64" ;;
    *)           WANT="" ;;
esac
HAVE="$(uname -m 2>/dev/null || echo "")"
if [ -n "$WANT" ] && [ -n "$HAVE" ] && [ "$WANT" != "$HAVE" ]; then
    die "комплект собран под $PLATFORM (${WANT}), а система — ${HAVE}.
Нужна сборка под эту архитектуру: ./run build --target linux/<арх>"
fi

if [ "$(id -u)" -ne 0 ]; then
    if [ $# -gt 0 ]; then
        die "нужны права root: sudo sh $0 $*"
    fi
    die "нужны права root: sudo sh $0"
fi

say "ovirt-backup $VERSION ($PLATFORM)"
verify

TMP="$(mktemp -d "${TMPDIR:-/tmp}/jhvirt-install.XXXXXX")" ||
    die "не удалось создать временный каталог"
trap 'rm -rf "$TMP"' EXIT INT TERM HUP

extract "$TMP"
[ -f "$TMP/$NAME/install.sh" ] || die "в архиве нет install.sh"
chmod 0755 "$TMP/$NAME/install.sh" 2>/dev/null || true

# Не exec: он заменил бы процесс и обработчик trap, а временный каталог
# остался бы в /tmp навсегда. Код возврата пробрасывается через set -e.
"$TMP/$NAME/install.sh" "$@"

# Выход обязателен: ниже начинается двоичный архив, и без этой строки оболочка
# дочитала бы скрипт до метки и попыталась выполнить её как команду. Установка
# при этом проходит, но код возврата становится 127 — то есть успешная
# установка выглядит как провал. Не удалять.
exit 0

__JHVIRT_ARCHIVE__
HEADER_EOF

    sed -e "s|@VERSION@|$V|g" \
        -e "s|@PLATFORM@|$P|g" \
        -e "s|@SHA256@|$SUM|g" \
        -e "s|@NAME@|$N|g" "$HDR" > "dist/$N.run"
    rm -f "$HDR"

    cat "dist/$N.tar.gz" >> "dist/$N.run"
    chmod 0755 "dist/$N.run"
    say "    dist/$N.run"
}

# --- Диспетчер --------------------------------------------------------------

COMMAND="${1:-help}"
[ $# -gt 0 ] && shift

case "$COMMAND" in
    build)          cmd_build "$@" ;;
    dev)            cmd_dev ;;
    web)            cmd_web ;;
    test)           cmd_test "$@" ;;
    test-db)        cmd_test_db "$@" ;;
    race)           cmd_race ;;
    check)          cmd_check ;;
    fmt|format)     cmd_fmt ;;
    vet)            cmd_vet ;;
    sbom)           cmd_sbom ;;
    vuln)           cmd_vuln ;;
    docker)         cmd_docker ;;
    version)        cmd_version ;;
    clean)          cmd_clean ;;
    clean-all)      cmd_clean_all ;;
    help|-h|--help) cmd_help ;;
    *)              printf 'неизвестная команда: %s\n\n' "$COMMAND" >&2; cmd_help >&2; exit 1 ;;
esac
