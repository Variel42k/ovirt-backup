# Образ из уже собранного комплекта.
#
# Отличается от корневого Dockerfile тем, что ничего не компилирует: бинарь и
# веб-интерфейс уже лежат рядом, их собрали на машине сборки. Поэтому на
# сервере не нужны ни Go, ни Node, ни исходники — образ строится за секунды из
# того, что приехало в .run.
#
# Корневой Dockerfile остаётся для сборки из репозитория; этот едет внутрь
# комплекта и используется установщиком.

FROM docker.io/library/alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

# Закреплённый Alpine уже содержит CA bundle и BusyBox wget. Установка из
# фиксированного .run не должна обращаться к меняющемуся пакетному mirror:
# qemu-img остаётся необязательным инструментом custom-образа, а база часовых
# поясов встроена в Go-бинарь.
RUN addgroup -g 10001 jhvirt && \
    adduser -u 10001 -G jhvirt -h /app -D jhvirt

WORKDIR /app
COPY bin/ovirt-backup-server /app/ovirt-backup-server
COPY web/dist /app/web/dist
COPY config/ovirt-backup.yaml /app/config/ovirt-backup.yaml

# Ключ шифрования секретов и временные файлы восстановления; при локальном
# хранилище — сами копии. База живёт снаружи, в PostgreSQL.
# /app/logs не создаётся: он лежал бы в слое контейнера и исчезал при каждом
# пересоздании, а при read_only был бы недоступен для записи. Журнал пишется
# в /app/data/logs, внутри тома.
RUN mkdir -p /app/data /backups /restores && \
    chmod 0755 /app/ovirt-backup-server && \
    chown -R jhvirt:jhvirt /app /backups /restores
VOLUME ["/app/data", "/backups"]

USER jhvirt
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1

ENTRYPOINT ["/app/ovirt-backup-server"]
CMD ["-config", "/app/config/ovirt-backup.yaml"]
