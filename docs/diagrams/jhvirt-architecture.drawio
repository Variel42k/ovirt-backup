try"/></mxCell><mxCell id="v88" value="&lt;b&gt;Хосты СУБД&lt;/b&gt;&lt;br&gt;PostgreSQL · MySQL / MariaDB&lt;br&gt;jhvirt-db-dump (forced command)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1150" y="700" width="320" height="70" as="geometry"/></mxCell><mxCell id="e89" value="SSH → логические дампы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=10;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v16" target="v88"><mxGeometry x="0.8" relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="315"/><mxPoint x="1090" y="315"/><mxPoint x="1090" y="735"/></Array></mxGeometry></mxCell><mxCell id="v90" value="🔒 хелпер без root · вход в СУБД через сокет, паролей нет · restore только в новую базу" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1150" y="774" width="320" height="40" as="geometry"/></mxCell><mxCell id="v91" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1490" y="686" width="390" height="182" as="geometry"/></mxCell><mxCell id="v92" value="&lt;b&gt;Легенда&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1500" y="692" width="200" height="20" as="geometry"/></mxCell><mxCell id="v93" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1502" y="718" width="30" height="16" as="geometry"/></mxCell><mxCell id="v94" value="Люди" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1540" y="715" width="140" height="22" as="geometry"/></mxCell><mxCell id="v95" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1502" y="742" width="30" height="16" as="geometry"/></mxCell><mxCell id="v96" value="Сервер копий" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1540" y="739" width="140" height="22" as="geometry"/></mxCell><mxCell id="v97" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1502" y="766" width="30" height="16" as="geometry"/></mxCell><mxCell id="v98" value="Единый вход" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1540" y="763" width="140" height="22" as="geometry"/></mxCell><mxCell id="v99" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1502" y="790" width="30" height="16" as="geometry"/></mxCell><mxCell id="v100" value="Платформы, хосты" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1540" y="787" width="140" height="22" as="geometry"/></mxCell><mxCell id="v101" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1687" y="718" width="30" height="16" as="geometry"/></mxCell><mxCell id="v102" value="Хранилища" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1725" y="715" width="140" height="22" as="geometry"/></mxCell><mxCell id="v103" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1687" y="742" width="30" height="16" as="geometry"/></mxCell><mxCell id="v104" value="Оповещения" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1725" y="739" width="140" height="22" as="geometry"/></mxCell><mxCell id="v105" value="" style="rounded=0;fillColor=#2e7d32;strokeColor=#2e7d32;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1687" y="773" width="30" height="2" as="geometry"/></mxCell><mxCell id="v106" value="Поток данных" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1725" y="763" width="140" height="22" as="geometry"/></mxCell><mxCell id="v107" value="🔒 защита" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1502" y="814" width="90" height="20" as="geometry"/></mxCell><mxCell id="v108" value="⚠ остаточный риск" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1598" y="814" width="130" height="20" as="geometry"/></mxCell><mxCell id="v109" value="&lt;i&gt;Слой «Защита» скрывается: Вид → Слои (Ctrl+Shift+L)&lt;/i&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="838" width="370" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Развёртывание (Docker Compose)"><mxGraphModel dx="1880" dy="1260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" value="Схема" parent="0"/><mxCell id="sec" value="Защита" parent="0"/><mxCell id="v1" value="2. Развёртывание: контейнеры, сети, тома и файлы хоста" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1820" height="34" as="geometry"/></mxCell><mxCell id="v2" value="Штатная установка из .run: docker compose в /opt/jhvirt/compose. Keycloak и keycloak-backup поднимаются только с профилем keycloak. Слой «Защита» — ограничения контейнеров и где лежит каждый секрет." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1820" height="40" as="geometry"/></mxCell><mxCell id="v3" value="Снаружи" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="280" height="1100" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;Браузер, API-клиенты, Prometheus&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="240" height="56" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Обратный прокси&lt;/b&gt; (необязательно)&lt;br&gt;TLS-терминация, внешний https://" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="240" height="64" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Исходящие соединения службы&lt;/b&gt;&lt;br&gt;движки oVirt, KVM-хосты, Proxmox,&lt;br&gt;S3 / SFTP / SMB / WebDAV,&lt;br&gt;SMTP, Telegram, webhook" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="240" height="100" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Active Directory&lt;/b&gt;&lt;br&gt;LDAPS :636" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="240" height="56" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Администратор ОС&lt;/b&gt;&lt;br&gt;root по SSH · docker compose ·&lt;br&gt;скрипты восстановления" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="240" height="70" as="geometry"/></mxCell><mxCell id="v9" value="Хост Linux: сервер копий" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="1540" height="1100" as="geometry"/></mxCell><mxCell id="v10" value="Docker Engine · проект compose" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="150" width="1060" height="700" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;сеть frontend&lt;/b&gt; (bridge) — публикация портов, выход к платформам, хранилищам и IdP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="360" y="190" width="1020" height="28" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;сеть database&lt;/b&gt; (internal: true) — без выхода наружу; порт 5432 на хост не публикуется" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=12;fillColor=#37474f;strokeColor=#37474f;" vertex="1" parent="1"><mxGeometry x="360" y="590" width="1020" height="28" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;ovirt-backup&lt;/b&gt; · образ ovirt-backup:VERSION&lt;br&gt;Go-служба + веб-интерфейс (SPA)&lt;br&gt;&lt;br&gt;• :8080 — веб, REST /api/v1, SSE, /metrics, /healthz&lt;br&gt;• /app/config/ovirt-backup.yaml (ro)&lt;br&gt;• /app/data ← том jhvirt-data&lt;br&gt;• /backups, /restores, /app/file-sources (ro), /app/file-restores&lt;br&gt;• /app/dr (ro) · /run/jhvirt-host (ro): сокет helper" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="250" width="420" height="200" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;keycloak&lt;/b&gt; · профиль keycloak&lt;br&gt;Keycloak 26.7.2, сборка --optimized&lt;br&gt;&lt;br&gt;• :8080 в контейнере → хост :8081&lt;br&gt;• keycloak.conf и БД-пароль в томе keycloak-data&lt;br&gt;• truststores (ro) — корпоративный CA для LDAPS&lt;br&gt;• vault (ro) — пароль bind в AD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="250" width="420" height="170" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;dr-backup&lt;/b&gt;&lt;br&gt;цикл раз в сутки:&lt;br&gt;pg_dump -Fc БД службы&lt;br&gt;+ копия secret.key" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="660" width="250" height="100" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;postgres&lt;/b&gt;&lt;br&gt;PostgreSQL 17 (alpine, hardened)&lt;br&gt;БД службы и БД Keycloak" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="690" y="650" width="300" height="120" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;keycloak-backup&lt;/b&gt; · профиль keycloak&lt;br&gt;pg_dump -Fc БД Keycloak" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="660" width="310" height="100" as="geometry"/></mxCell><mxCell id="e18" value="" style="rounded=0;html=1;endArrow=none;strokeColor=#78909c;strokeWidth=2;fontFamily=Helvetica;exitX=0.5;exitY=0;entryX=0.216;entryY=1;" edge="1" parent="1" source="v13" target="v11"><mxGeometry relative="1" as="geometry"></mxGeo