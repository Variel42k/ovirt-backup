mxCell id="v54" value="🔒 read_only · cap_drop ALL · no-new-privileges · образ закреплён по digest · vault и truststore только для чтения" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="950" y="425" width="420" height="44" as="geometry"/></mxCell><mxCell id="v55" value="🔒 cap_add только CHOWN, DAC_OVERRIDE, FOWNER, SETGID, SETUID · read_only · scram-sha-256 · PUBLIC без CONNECT/CREATE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="640" y="775" width="400" height="44" as="geometry"/></mxCell><mxCell id="v56" value="🔒 UID 10001 · jhvirt-data только чтение · 0.5 CPU / 256 MiB / 64 PID" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="370" y="765" width="250" height="44" as="geometry"/></mxCell><mxCell id="v57" value="🔒 UID 1000 · keycloak-data только чтение" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1060" y="765" width="310" height="26" as="geometry"/></mxCell><mxCell id="v58" value="🔒 секреты — файлы 0600, не environment; в docker inspect не видны" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="360" y="1045" 