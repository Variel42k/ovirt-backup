[Unit]
Description=justhpc-virt-manager
Documentation=file:/opt/jhvirt/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jhvirt
Group=jhvirt
WorkingDirectory=/opt/jhvirt
ExecStart=/opt/jhvirt/bin/justhpc-virt-server -config /opt/jhvirt/config/virt-manager.yaml
Restart=on-failure
RestartSec=5s

# Секреты (пароль СУБД) — из файла с правами 0600, а не в юните: юнит читают все.
# Минус перед путём означает «нет файла — не ошибка».
EnvironmentFile=-/opt/jhvirt/config/jhvirt.env

# Сервису нужны только свои каталоги. Если локальное хранилище копий или
# каталог восстановления лежат вне /opt/jhvirt, добавьте их пути в
# ReadWritePaths — иначе запись отклонит ядро, а причина в сообщении об ошибке
# видна не сразу.
#
# Каталог восстановления при этом надо разрешить дважды: здесь — службе,
# и в backup.restore_dirs — оператору. Списки закрывают разное, и каталог,
# прописанный только в одном, работать не будет.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/jhvirt/data /opt/jhvirt/logs

# Восстановление и проверка держат много открытых объектов хранилища.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
