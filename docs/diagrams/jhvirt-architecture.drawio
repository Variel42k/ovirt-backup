116" value="—" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#bdbdbd;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="816" y="986" width="70" height="34" as="geometry"/></mxCell><mxCell id="v117" value="—" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#bdbdbd;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="890" y="986" width="70" height="34" as="geometry"/></mxCell><mxCell id="v118" value="—" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#bdbdbd;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="964" y="986" width="70" height="34" as="geometry"/></mxCell><mxCell id="v119" value="—" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#bdbdbd;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1038" y="986" width="70" height="34" as="geometry"/></mxCell><mxCell id="v120" value="R — чтение · W — изменение и запуск · D — разрушающие действия (фенсинг, сброс ВМ) · A — администрирование" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1060" height="22" as="geometry"/></mxCell><mxCell id="v121" value="🔒 users.admin позволяет выдать себе любое право — выдавать только администраторам службы" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="40" y="1058" width="520" height="30" as="geometry"/></mxCell><mxCell id="v122" value="🔒 проверка права — на каждом маршруте сервера; интерфейс лишь скрывает недоступное" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="570" y="1058" width="530" height="30" as="geometry"/></mxCell><mxCell id="v123" value="🔒 журнал службы перечисляет все ВМ и хосты — logs.read только у admin; аудит — audit.read" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="40" y="1092" width="1060" height="22" as="geometry"/></mxCell><mxCell id="v124" value="Группы Keycloak по умолчанию: virt-admins → admin, virt-operators → operator, virt-readers → viewer. Соответствие задаётся auth.oidc.role_mapping в файле настроек." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1126" width="1060" height="36" as="geometry"/></mxCell><mxCell id="v125" value="Опасные действия: согласование второго человека" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1140" y="830" width="720" height="420" as="geometry"/></mxCell><mxCell id="v126" value="• backup.delete — удаление копии&lt;br&gt;• retention.apply — ручная ретенция&lt;br&gt;• job.delete — удаление задания&lt;br&gt;• storage.delete, storage.retarget — хранилища&lt;br&gt;• server.delete — подключение&lt;br&gt;• audit.disable — отключение аудита&lt;br&gt;• approval.policy.update — сама политика&lt;br&gt;• remediation.manual — ручное оживление" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="870" width="330" height="200" as="geometry"/></mxCell><mxCell id="v127" value="&lt;b&gt;Заявка&lt;/b&gt;&lt;br&gt;объект, сводка, инициатор" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1520" y="870" width="320" height="50" as="geometry"/></mxCell><mxCell id="v128" value="&lt;b&gt;Кворум&lt;/b&gt; (по умолчанию 2)&lt;br&gt;подтверждения согласующих" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1520" y="940" width="320" height="50" as="geometry"/></mxCell><mxCell id="v129" value="&lt;b&gt;Выполнение&lt;/b&gt; ровно того,&lt;br&gt;что было в заявке" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1520" y="1010" width="320" height="50" as="geometry"/></mxCell><mxCell id="e130" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v127" target="v128"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e131" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v128" target="v129"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v132" value="&lt;b&gt;Break-glass&lt;/b&gt;: выполнить без кворума&lt;br&gt;с указанием причины" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffebee;strokeColor=#c62828;fontSize=11;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="1086" width="330" height="50" as="geometry"/></mxCell><mxCell id="v133" value="🔒 заявка сверяется с запросом: действие, объект и сводка должны совпасть — одобрение не переносится на другой объект или другой план ретенции" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1520" y="1070" width="320" height="56" as="geometry"/></mxCell><mxCell id="v134" value="🔒 break-glass поднимает оповещение break_glass_used для аудитории безопасности и пишется в аудит" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1160" y="1142" width="330" height="44" as="geometry"/></mxCell><mxCell id="v135" value="🔒 смена политики согласований сама требует согласования" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1520" y="1132" width="320" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11" name="11. Безопасное подключение движка"><mxGraphModel dx="1880" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" value="Схема" parent="0"/><mxCell id="sec" value="Защита" parent="0"/><mxCell id="v1" value="11. Безопасное подключение движка: роль с минимальными правами вместо пароля администратора" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1820" height="34" as="geometry"/></mxCell><mxCell id="v2" value="Администратор движка вводится один раз: под ним создаётся роль jhvirt-backup, выдаётся сервисной записи, доступ проверяется — и сохраняется только сервисная запись." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1820" height="40" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Что защищает шаг&lt;/b&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="118" width="380" height="40" as="geometry"/></mxCell><mxCell id="v38" value="&lt;b&gt;Администратор&lt;/b&gt;&lt;br&gt;мастер в веб-интерфейсе" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="15" y="110" width="210" height="58" as="geometry"/></mxCell><mxCell id="a39" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="168" as="sourcePoint"/><mxPoint x="120" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v40" value="&lt;b&gt;ovirt-backup&lt;/b&gt;&lt;br&gt;POST /servers/provision" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="285" y="110" width="210" height="58" as="geometry"/></mxCell><mxCell id="a41" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="168" as="sourcePoint"/><mxPoint x="390" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v42" value="&lt;b&gt;Движок oVirt / РЕД&lt;/b&gt;&lt;br&gt;REST API :443" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="555" y="110" width="210" height="58" as="geometry"/></mxCell><mxCell id="a43" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="168" as="sourcePoint"/><mxPoint x="660" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v44" value="&lt;b&gt;Каталог пользователей&lt;/b&gt;&lt;br&gt;internal-authz или AD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="825" y="110" width="210" height="58" as="geometry"/></mxCell><mxCell id="a45" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930" y="168" as="sourcePoint"/><mxPoint x="930" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v4" value="0. Однократно на движке — вне службы" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ede7f6;strokeColor=#5e35b1;dashed=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="1010" height="24" as="geometry"/></mxCell><mxCell id="a5" value="создать сервисную запись: ovirt-aaa-jdbc-tool user add … (internal)&lt;br&gt;или учётку в AD — REST движка пользователей не создаёт" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="260" as="sourcePoint"/><mxPoint x="930" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v6" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="232" width="26" height="26" as="geometry"/></mxCell><mxCell id="v7" value="1. Мастер «Настроить сервисную запись»" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ede7f6;strokeColor=#5e35b1;dashed=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="1010" height="24" as="geometry"/></mxCell><mxCell id="a8" value="адрес, CA движка, разовый администратор, сервисная запись" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="337" as="sourcePoint"/><mxPoint x="390" y="337" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v9" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="322" width="26" height="26" as="geometry"/></mxCell><mxCell id="v10" value="🔒 нужно право servers.admin; пароль администратора живёт только в этом запросе" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1060" y="320" width="380" height="30" as="geometry"/></mxCell><mxCell id="a11" value="SSO-вход разовым администратором" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="377" as="sourcePoint"/><mxPoint x="660" y="377" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v12" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="362" width="26" height="26" as="geometry"/></mxCell><mxCell id="v13" value="🔒 HTTPS с проверкой сохранённого CA; insecure_tls — только явно, с оповещением через 14 суток" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1060" y="360" width="380" height="30" as="geometry"/></mxCell><mxCell id="a14" value="GET /clusterlevels — каталог прав: имя → id" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="417" as="sourcePoint"/><mxPoint x="660" y="417" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="402" width="26" height="26" as="geometry"/></mxCell><mxCell id="a16" value="" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="446" as="sourcePoint"/><mxPoint x="390" y="464" as="targetPoint"/><Array as="points"><mxPoint x="424" y="446"/><mxPoint x="424" y="464"/></Array></mxGeometry></mxCell><mxCell id="v17" value="желаемые 10 прав ∩ каталог движка" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="440" width="250" height="22" as="geometry"/></mxCell><mxCell id="v18" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="442" width="26" height="26" as="geometry"/></mxCell><mxCell id="v19" value="🔒 неизвестные движку права видны в отчёте, а не молча теряются; проверено на РЕД 7.3 (уровни 4.2–4.6)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1060" y="440" width="380" height="42" as="geometry"/></mxCell><mxCell id="a20" value="POST /roles jhvirt-backup {permits: [id…]}" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="507" as="sourcePoint"/><mxPoint x="660" y="507" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v21" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="492" width="26" height="26" as="geometry"/></mxCell><mxCell id="a22" value="найти запись по principal в домене authz" style="rounded=0;ht