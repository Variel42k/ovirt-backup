ающая операция в аудите" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1370" y="250" width="470" height="36" as="geometry"/></mxCell><mxCell id="v47" value="&lt;b&gt;Новый диск&lt;/b&gt; в домене хранения oVirt&lt;br&gt;imagetransfer upload" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="980" y="346" width="380" height="76" as="geometry"/></mxCell><mxCell id="e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=10;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v31" target="v47"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="955" y="670"/><mxPoint x="955" y="384"/></Array></mxGeometry></mxCell><mxCell id="v49" value="🔒 проверка свободного места домена; неизвестное место — предупреждение в плане" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1370" y="346" width="470" height="36" as="geometry"/></mxCell><mxCell id="v50" value="&lt;b&gt;Новая ВМ oVirt / РЕД&lt;/b&gt;&lt;br&gt;preview → ВМ без запуска → диски → upload → NIC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="980" y="442" width="380" height="76" as="geometry"/></mxCell><mxCell id="e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded