mxGeometry x="1200" y="978" width="380" height="30" as="geometry"/></mxCell><mxCell id="v49" value="3. Если заморозка не удалась" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffebee;strokeColor=#c62828;fontSize=11;spacing=6;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="1016" width="1120" height="24" as="geometry"/></mxCell><mxCell id="a50" value="агент недоступен · хук вернул ≠ 0 · тайм-аут" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#c62828;dashed=1;fontSize=11;fontColor=#b71c1c;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="1073" as="sourcePoint"/><mxPoint x="130" y="1073" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v51" value="17" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="1058" width="26" height="26" as="geometry"/></mxCell><mxCell id="a52" value="" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="1102" as="sourcePoint"/><mxPoint x="130" y="1120" as="targetPoint"/><Array as="points"><mxPoint x="164" y="1102"/><mxPoint x="164" y="1120"/></Array></mxGeometry></mxCell><mxCell id="v53" value="политика задания:&lt;br&gt;прервать или продолжить как crash" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="1096" width="250" height="36" as="geometry"/></mxCell><mxCell id="v54" value="18" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="1098" width="26" height="26" as="geometry"/></mxCell><mxCell id="v55" value="🔒 отказ до начала бэкапа: блокировок на движке ещё нет, прерывание безопасно" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1200" y="1096" width="380" height="30" as="geometry"/></mxCell><mxCell id="v56" value="🔒 понижение уровня больше не молчит: причина в запуске и оповещение consistency_degraded" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1200" y="1130" width="380" height="30" as="geometry"/></mxCell><mxCell id="v67" value="Уровни согласованности точки" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="1196" width="900" height="250" as="geometry"/></mxCell><mxCell id="v68" value="&lt;b&gt;crash&lt;/b&gt;" style="rounded=1;html=1;fillColor=#ffcdd2;strokeColor=#9e9e9e;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1236" width="140" height="50" as="geometry"/></mxCell><mxCell id="v69" value="как после выключения питания: СУБД восстановится по журналу (WAL / redo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="190" y="1236" width="710" height="50" as="geometry"/></mxCell><mxCell id="v70" value="&lt;b&gt;filesystem&lt;/b&gt;" style="rounded=1;html=1;fillColor=#fff3e0;strokeColor=#9e9e9e;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1296" width="140" height="50" as="geometry"/></mxCell><mxCell id="v71" value="ФС заморожены агентом: метаданные ФС целы, СУБД всё равно проходит восстановление" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="190" y="1296" width="710" height="50" as="geometry"/></mxCell><mxCell id="v72" value="&lt;b&gt;application&lt;/b&gt;" style="rounded=1;html=1;fillColor=#c8e6c9;strokeColor=#9e9e9e;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1356" width="140" height="50" as="geometry"/></mxCell><mxCell id="v73" value="СУБД сбросила буферы или удерживает блокировку: чистый старт, минимальное восстановление" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="190" y="1356" width="710" height="50" as="geometry"/></mxCell><mxCell id="v74" value="Windows: qemu-ga с VSS-провайдером вызывает VSS-писателей (SQL Server, Exchange) — уровень application без сценариев; PostgreSQL под Windows VSS-писателя не имеет." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1408" width="860" height="34" as="geometry"/></mxCell><mxCell id="v75" value="Что сделано (этап 1)" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="940" y="1196" width="920" height="250" as="geometry"/></mxCell><mxCell id="v76" value="• задание: consistency = crash | filesystem | application и require_consistency;&lt;br&gt;&amp;nbsp;&amp;nbsp;миграция 0043: quiesce=true → filesystem, поведение прежних заданий не меняется&lt;br&gt;• запуск: backup_runs.consistency и consistency_note; те же поля в run.json и при импорте каталога&lt;br&gt;• backup.QuiesceGuest — одна политика для oVirt (Backup API и снапшот) и KVM&lt;br&gt;• интерфейс: «Согласованность копии» и «Прервать запуск…» в задании, метка и причина у точки&lt;br&gt;• scheduler: оповещение backup_consistency_degraded, снимается следующей нормальной точкой&lt;br&gt;• deploy/guest-hooks: строгий диспетчер, сценарии PostgreSQL и MySQL/MariaDB, install.sh --check&lt;br&gt;• Proxmox: заморозку делает vzdump, требовать уровень нельзя" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ede7f6;strokeColor=#5e35b1;dashed=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="1236" width="880" height="196" as="geometry"/></mxCell><mxCell id="v77" value="⚠ хуки ставит администратор гостя: служба не проверяет их наличие без выполнения команд в госте — уровень application определяется настройкой задания и успешной заморозкой" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="20" y="1458" width="900" height="36" as="geometry"/></mxCell><mxCell id="v78" value="⚠ заморозка всех ФС сразу: данные и WAL на разных разделах фиксируются одновременно, но СУБД на сетевых ФС внутри гостя (NFS, iSCSI вне дисков ВМ) в копию не попадают" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="940" y="1458" width="920" height="36" as="geometry"/></mxCell><mxCell id="v79" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="1506" width="770" height="134" as="geometry"/></mxCell><mxCell id="v80" value="&lt;b&gt;Легенда&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1512" width="200" height="20" as="geometry"/></mxCell><mxCell id="v81" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="32" y="1538" width="30" height="16" as="geometry"/></mxCell><mxCell id="v82" value="Сервер копий (ovirt-backup)" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="1535" width="205" height="22" as="geometry"/></mxCell><mxCell id="v83" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="32" y="1562" width="30" height="16" as="geometry"/></mxCell><mxCell id="v84" value="Платформы виртуализации" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="1559" width="205" height="22" as="geometry"/></mxCell><mxCell id="v85" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="282" y="1538" width="30" height="16" as="geometry"/></mxCell><mxCell id="v86" value="Хранилища и данные" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320" y="1535" width="205" height="22" as="geometry"/></mxCell><mxCell id="v87" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ede7f6;strokeColor=#5e35b1;dashed=1;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="282" y="1562" width="30" height="16" as="geometry"/></mxCell><mxCell id="v88" value="Добавлено этапом 1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320" y="1559" width="205" height="22" as="geometry"/></mxCell><mxCell id="v89" value="" style="rounded=0;fillColor=#5e35b1;strokeColor=#5e35b1;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="532" y="1545" width="30" height="2" as="geometry"/></mxCell><mxCell id="v90" value="Новый поток" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="1535" width="205" height="22" as="geometry"/></mxCell><mxCell id="v91" value="" style="rounded=0;fillColor=#546e7a;strokeColor=#546e7a;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="532" y="1569" width="30" height="2" as="geometry"/></mxCell><mxCell id="v92" value="Управляющий вызов" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="1559" width="205" height="22" as="geometry"/></mxCell><mxCell id="v93" value="🔒 защита" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="32" y="1586" width="90" height="20" as="geometry"/></mxCell><mxCell id="v94" value="⚠ остаточный риск" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="128" y="1586" width="130" height="20" as="geometry"/></mxCell><mxCell id="v95" value="&lt;i&gt;Слой «Защита» скрывается: Вид → Слои (Ctrl+Shift+L)&lt;/i&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="1610" width="750" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p14" name="14. СУБД, этап 2: логические дампы"><mxGraphModel dx="1880" dy="1486" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1486" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" value="Схема" parent="0"/><mxCell id="sec" value="Защита" parent="0"/><mxCell id="v1" value="14. Бэкап СУБД, этап 2 (реализовано): логические дампы отдельным типом заданий" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1820" height="34" as="geometry"/></mxCell><mxCell id="v2" value="Дамп отдельной базы без копирования всей ВМ: для выборочного восстановления, переноса между версиями и физических серверов. Устроено по образцу Proxmox — forced command на хосте СУБД, — но без root." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1820" height="40" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Что защищает шаг&lt;/b&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1280" y="118" width="380" height="40" as="geometry"/></mxCell><mxCell id="v52" value="&lt;b&gt;Служба&lt;/b&gt;&lt;br&gt;internal/dbdump" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ede7f6;strokeColor=#5e35b1;dashed=1;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="200" height="58" as="geometry"/></mxCell><mxCell id="a53" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="168" as="sourcePoint"/><mxPoint x="130" y="1016" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v54" value="&lt;b&gt;Хост СУБД&lt;/b&gt;&lt;br&gt;sshd + jhvirt-db-dump" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ede7f6;strokeColor=#5e35b1;dashed=1;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="200" height="58" as="geometry"/></mxCell><mxCell id="a55" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="168" as="sourcePoint"/><mxPoint x="380" y="1016" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v56" value="&lt;b&gt;СУБД&lt;/b&gt;&lt;br&gt;pg_dump · mysqldump" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="110" width="200" height="58" as="geometry"/></mxCell><mxCell id="a57" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="168" as="sourcePoint"/><mxPoint x="630" y="1016" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v58" value="&lt;b&gt;DiskWriter&lt;/b&gt;&lt;br&gt;в службе" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="200" height="58" as="geometry"/></mxCell><mxCell id="a59" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="168" as="sourcePoint"/><mxPoint x="880" y="1016" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v60" value="&lt;b&gt;Хранилище копий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1030" y="110" width="200" height="58" as="geometry"/></mxCell><mxCell id="a61" value="" style="rounded=0;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#90a4ae;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="168" as="sourcePoint"/><mxPoint x="1130" y="1016" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v4" value="1. Подключение хоста СУБД (однократно: setup.sh на хосте, «Хост СУБД» в интерфейсе)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ede7f6;strokeColor=#5e35b1;dashed=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="1200" height="24" as="geometry"/></mxCell><mxCell id="a5" value="SSH: probe → протокол, СУБД и версии, разрешено ли восстановление" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5e35b1;strokeWidth=2;fontSize=11;fontColor=#4527a0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="247" as="sourcePoint"/><mxPoint x="380" y="247" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v6" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="232" width="26" height="26" as="geometry"/></mxCell><mxCell id="v7" value="🔒 вход только по ключу; host key закреплён — как у KVM и SFTP; ключ зашифрован secret.key" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1280" y="230" width="380" height="30" as="geometry"/></mxCell><mxCell id="a8" value="" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="276" as="sourcePoint"/><mxPoint x="380" y="294" as="targetPoint"/><Array as="points"><mxPoint x="414" y="276"/><mxPoint x="414" y="294"/></Array></mxGeometry></mxCell><mxCell id="v9" value="authorized_keys: restrict,command=&lt;br&gt;/usr/local/sbin/jhvirt-db-dump" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="270" width="250" height="36" as="geometry"/></mxCell><mxCell id="v10" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="272" width="26" height="26" as="geometry"/></mxCell><mxCell id="v11" value="🔒 без shell, pty и проброса портов; хелпер отказывается работать от root" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1280" y="270" width="380" height="30" as="geometry"/></mxCell><mxCell id="a12" value="list postgresql | mysql → базы (без системных)" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5e35b1;strokeWidth=2;fontSize=11;fontColor=#4527a0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="337" as="sourcePoint"/><mxPoint x="380" y="337" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v13" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="322" width="26" height="26" as="geometry"/></mxCell><mxCell id="v14" value="2. Дамп по расписанию или кнопке" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ede7f6;strokeColor=#5e35b1;dashed=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="358" width="1200" height="24" as="geometry"/></mxCell><mxCell id="a15" value="dump postgresql billing" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5e35b1;strokeWidth=2;fontSize=11;fontColor=#4527a0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="415" as="sourcePoint"/><mxPoint x="380" y="415" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v16" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="400" width="26" height="26" as="geometry"/></mxCell><mxCell id="v17" value="🔒 строка команды проверяется целиком до разбора; имя базы — [A-Za-z0-9_.-] на обоих концах" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1280" y="398" width="380" height="30" as="geometry"/></mxCell><mxCell id="a18" value="pg_dump -Fc --compress=0 через Unix-сокет, роль jhvirt_dump&lt;br&gt;(MySQL: mysqldump --single-transaction --routines --events)" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5e35b1;strokeWidth=2;fontSize=11;fontColor=#4527a0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="468" as="sourcePoint"/><mxPoint x="630" y="468" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v19" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="440" width="26" height="26" as="geometry"/></mxCell><mxCell id="v20" value="🔒 паролей СУБД нет нигде: peer / unix_socket / auth_socket; роль только на чтение" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1280" y="438" width="380" height="30" as="geometry"/></mxCell><mxCell id="v21" value="⚠ --single-transaction согласован только для InnoDB; таблицы MyISAM читаются без снимка" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1280" y="472" width="380" height="30" as="geometry"/></mxCell><mxCell id="a22" value="поток дампа: stdout → SSH-канал" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=3;fontSize=11;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="527" as="sourcePoint"/><mxPoint x="880" y="527" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v23" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="512" width="26" height="26" as="geometry"/></mxCell><mxCell id="a24" value="" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="556" as="sourcePoint"/><mxPoint x="880" y="574" as="targetPoint"/><Array as="points"><mxPoint x="914" y="556"/><mxPoint x="914" y="574"/></Array></mxGeometry></mxCell><mxCell id="v25" value="чанки → SHA-256 → zstd → AES-256-GCM" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="550" width="250" height="22" as="geometry"/></mxCell><mxCell id="v26" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="552" width="26" height="26" as="geometry"/></mxCell><mxCell id="v27" value="🔒 шифрование в задании включено по умолчанию: дамп — все данные базы открытым текстом" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1280" y="550" width="380" height="30" as="geometry"/></mxCell><mxCell id="a28" value="db-000-billing.data" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=3;fontSize=11;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="607" as="sourcePoint"/><mxPoint x="1130" y="607" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v29" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="592" width="26" height="26" as="geometry"/></mxCell><mxCell id="a30" value="globals postgresql: pg_dumpall --globals-only --no-role-passwords" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5e35b1;strokeWidth=2;fontSize=11;fontColor=#4527a0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="647" as="sourcePoint"/><mxPoint x="380" y="647" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v31" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="632" width="26" height="26" as="geometry"/></mxCell><mxCell id="v32" value="🔒 роли без хешей паролей; служба их не применяет — это делает администратор СУБД" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1280" y="630" width="380" height="30" as="geometry"/></mxCell><mxCell id="a33" value="dumps.manifest — последним" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5e35b1;strokeWidth=2;fontSize=11;fontColor=#4527a0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="687" as="sourcePoint"/><mxPoint x="1130" y="687" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v34" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="672" width="26" height="26" as="geometry"/></mxCell><mxCell id="v35" value="🔒 сбой одной базы не отменяет остальные: точка «частично», оповещение «Ошибка бэкапа»" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1280" y="670" width="380" height="30" as="geometry"/></mxCell><mxCell id="a36" value="копии в запасные хранилища: байт в байт, сверка SHA-256" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=3;fontSize=11;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="727" as="sourcePoint"/><mxPoint x="1130" y="727" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v37" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="712" width="26" height="26" as="geometry"/></mxCell><mxCell id="a38" value="проверка: чтение, расшифровка, SHA-256 каждого чанка, длина" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=3;fontSize=11;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="767" as="sourcePoint"/><mxPoint x="880" y="767" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v39" value="12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="752" width="26" height="26" as="geometry"/></mxCell><mxCell id="v40" value="🔒 verify_after по умолчанию: нечитаемый дамп виден в ночь съёмки; сбой — оповещение «Ошибка проверки»" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1280" y="750" width="380" height="42" as="geometry"/></mxCell><mxCell id="v41" value="3. Восстановление — только в новую базу" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ede7f6;strokeColor=#5e35b1;dashed=1;fontSize=12;spacing=6;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="798" width="1200" height="24" as="geometry"/></mxCell><mxCell id="a42" value="чтение, расшифровка, сверка SHA-256 каждого чанка" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=3;fontSize=11;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="855" as="sourcePoint"/><mxPoint x="880" y="855" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v43" value="13" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="840" width="26" height="26" as="geometry"/></mxCell><mxCell id="a44" value="restore postgresql billing_restored_20260919" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5e35b1;strokeWidth=2;fontSize=11;fontColor=#4527a0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="895" as="sourcePoint"/><mxPoint x="380" y="895" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v45" value="14" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="880" width="26" height="26" as="geometry"/></mxCell><mxCell id="v46" value="🔒 выключено на хосте по умолчанию (JHVIRT_DB_ALLOW_RESTORE=0)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1280" y="878" width="380" height="30" as="geometry"/></mxCell><mxCell id="a47" value="поток в stdin: CREATE DATABASE → pg_restore --no-owner --exit-on-error" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=3;fontSize=11;fontColor=#1b5e20;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="935" as="sourcePoint"/><mxPoint x="630" y="935" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v48" value="15" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="920" width="26" height="26" as="geometry"/></mxCell><mxCell id="v49" value="🔒 существующая база не перезаписывается — CREATE DATABASE откажет; при сбое удаляется только созданная этим вызовом база" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1280" y="918" width="380" height="42" as="geometry"/></mxCell><mxCell id="a50" value="итог → «Восстановления» в интерфейсе и журнал аудита" style="rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#78909c;fontSize=11;fontColor=#455a64;labelBackgroundColor=#ffffff;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="985" as="sourcePoint"/><mxPoint x="130" y="985" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v51" value="16" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="970" width="26" height="26" as="geometry"/></mxCell><mxCell id="v62" value="Что сделано (этап 2)" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="1036" width="1240" height="300" as="geometry"/></mxCell><mxCell id="v63" value="• хост СУБД: адрес, SSH-пользователь, ключ (зашифрован), закреплённый host key; «Проверить» = probe&lt;br&gt;• задание: хост, СУБД, базы (список или все), роли PostgreSQL, хранилища, расписание, ретенция, шифрование&lt;br&gt;• internal/dbdump: поток SSH → DiskWriter, dumps.manifest последним, копии, ретенция, восстановление&lt;br&gt;• раскладка jhvirt/db/&amp;lt;хост&amp;gt;/&amp;lt;СУБД&amp;gt;/&amp;lt;дата&amp;gt;/&amp;lt;run&amp;gt;/ — db-NNN-&amp;lt;база&amp;gt;.data + dumps.manifest&lt;br&gt;• права — существующие: servers.admin (хост), jobs.* (задания), backups.* (точки, восстановление)&lt;br&gt;• проверка точки после дампа и по кнопке; удаление точки — опасное действие backup.delete&lt;br&gt;• deploy/db-dump: хелпер, setup.sh (пользователь, ключ с restrict,command, роль), db-dump.conf.example&lt;br&gt;• интерфейс: страница «Дампы СУБД» — хосты, задания, точки по базам, восстановление в новую базу" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ede7f6;strokeColor=#5e35b1;dashed=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1076" width="1200" height="200" as="geometry"/></mxCell><mxCell id="v64" value="&lt;b&gt;Чем этап 2 дополняет этап 1&lt;/b&gt;: копия ВМ даёт всю машину целиком, дамп — отдельную базу, переносимую между версиями и хостами, и защищает физические серверы СУБД без виртуализации." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1286" width="1200" height="40" as="geometry"/></mxCell><mxCell id="v65" value="Остаточные риски" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1280" y="1036" width="580" height="300" as="geometry"/></mxCell><mxCell id="v66" value="⚠ роль дампа читает все данные базы — это её назначение; SSH-ключ службы — актив уровня самой СУБД" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1300" y="1076" width="540" height="44" as="geometry"/></mxCell><mxCell id="v67" value="⚠ при выключенном шифровании в задании дамп лежит в хранилище открытым" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec