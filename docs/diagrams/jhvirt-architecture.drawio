ly=Helvetica;" vertex="1" parent="1"><mxGeometry x="398" y="810" width="60" height="40" as="geometry"/></mxCell><mxCell id="v73" value="0" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#37474f;strokeWidth=2;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="464" y="810" width="60" height="40" as="geometry"/></mxCell><mxCell id="v74" value="I2" style="rounded=0;html=1;fillColor=#ffe0b2;strokeColor=#37474f;strokeWidth=2;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="810" width="60" height="40" as="geometry"/></mxCell><mxCell id="v75" value="F" style="rounded=0;html=1;fillColor=#c8e6c9;strokeColor=#37474f;strokeWidth=2;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="596" y="810" width="60" height="40" as="geometry"/></mxCell><mxCell id="v76" value="I2" style="rounded=0;html=1;fillColor=#ffe0b2;strokeColor=#37474f;strokeWidth=2;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="662" y="810" width="60" height="40" as="geometry"/></mxCell><mxCell id="v77" value="F" style="rounded=0;html=1;fillColor=#c8e6c9;strokeColor=#37474f;strokeWidth=2;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="728" y="810" width="60" height="40" as="geometry"/></mxCell><mxCell id="v78" value="0" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#37474f;strokeWidth=2;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="794" y="810" width="60" height="40" as="geometry"/></mxCell><mxCell id="v79" value="Чанка нет во всей цепочке → область нулевая: полная копия сохраняет каждый непустой экстент. Поэтому цепочка без корня отвергается, а ретенция никогда не удаляет предка сохраняемого инкремента." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="860" height="40" as="geometry"/></mxCell><mxCell id="v80" value="Каждое звено читается по своему манифесту: цепочка full(zstd) → incr(gzip) → incr(s2) собирается как обычно." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="924" width="860" height="30" as="geometry"/></mxCell><mxCell id="v81" value="Ключ secret.key и что им зашифровано" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="940" y="560" width="920" height="420" as="geometry"/></mxCell><mxCell id="v82" value="&lt;b&gt;data/secret.key&lt;/b&gt;&lt;br&gt;256 бит в base64 · 0600 · UID 10001&lt;br&gt;читается при старте" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffde7;strokeColor=#b59f3b;fontSize=11;spacing=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="700" width="230" height="80" as="geometry"/></mxCell><mxCell id="v83" value="пароли и ключи подключений: движки, KVM, Proxmox (API token, SSH-ключ)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1280" y="592" width="500" height="48" as="geometry"/></mxCell><mxCell id="e84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v82" target="v83"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="740"/><mxPoint x="1240" y="616"/></Array></mxGeometry></mxCell><mxCell id="v85" value="ключи хранилищ: S3 secret, SFTP-ключ, пароли SMB и WebDAV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1280" y="648" width="500" height="48" as="geometry"/></mxCell><mxCell id="e86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v82" target="v85"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="740"/><mxPoint x="1240" y="672"/></Array></mxGeometry></mxCell><mxCell id="v87" value="OIDC id_token в сессии (для выхода у провайдера)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1280" y="704" width="500" height="48" as="geometry"/></mxCell><mxCell id="e88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v82" target="v87"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="740"/><mxPoint x="1240" y="728"/></Array></mxGeometry></mxCell><mxCell id="v89" value="чанки дисковых копий и QCOW2-артефактов — если включено" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1280" y="760" width="500" height="48" as="geometry"/></mxCell><mxCell id="e90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v82" target="v89"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="740"/><mxPoint x="1240" y="784"/></Array></mxGeometry></mxCell><mxCell id="v91" value="снимки конфигурации Engine (.json.enc) и файловые копии — если включено" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1280" y="816" width="500" height="48" as="geometry"/></mxCell><mxCell id="e92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=10;fontColor=#37474f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v82" target="v91"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="740"/><mxPoint x="1240" y="840"/></Array></mxGeometry></mxCell><mxCell id="v93" value="&lt;b&gt;DR-комплект&lt;/b&gt;: копия ключа&lt;br&gt;рядом с ежедневным pg_dump" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="820" width="230" height="56" as="geometry"/></mxCell><mxCell id="v94" value="Шифрование — последнее преобразование при записи и первое при чтении. Алгоритмы берутся из манифеста звена, а не из текущих настроек." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="930" width="880" height="36" as="geometry"/></mxCell><mxCell id="v95" value="🔒 GCM ловит изменение шифртекста; случайный nonce 12 B на каждый чанк" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1150" y="243" width="380" height="18" as="geometry"/></mxCell><mxCell id="v96" value="🔒 h сверяется после расшифровки и распаковки — порча видна проверкой manifest / restore" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="620" y="243" width="520" height="18" as="geometry"/></mxCell><mxCell id="v97" value="🔒 data_sha256 всего объекта — проверка одним потоковым чтением; run.json последним = точка завершена" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="620" y="470" width="1220" height="22" as="geometry"/></mxCell><mxCell id="v98" value="⚠ манифест и run.json открыты: видны имена ВМ и дисков, размеры и SHA-256 открытых чанков — по ним можно подтвердить наличие известного блока" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="620" y="496" width="610" height="30" as="geometry"/></mxCell><mxCell id="v99" value="⚠ чанк не привязан к позиции (без AAD), манифест не подписан: с правом записи в хранилище возможна перестановка чанков — закрывают Object Lock и права хранилища" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1236" y="496" width="604" height="30" as="geometry"/></mxCell><mxCell id="v100" value="🔒 без ключа копия разбирается, но не читается: jvbackup покажет состав точки по манифестам" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="40" y="494" width="520" height="30" as="geometry"/></mxCell><mxCell id="v101" value="⚠ потеря secret.key необратима; простая замена ключа = нечитаемые старые копии и секреты, нужны новые полные цепочки" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="960" y="885" width="450" height="36" as="geometry"/></mxCell><mxCell id="v102" value="🔒 храните копию ключа отдельно от копий ВМ и от dr-backups на том же хосте" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1420" y="885" width="420" height="36" as="geometry"/></mxCell><mxCell id="v103" value="🔒 ретенция никогда не рвёт цепочку; последняя копия ВМ не удаляется" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="40" y="954" width="860" height="20" as="geometry"/></mxCell><mxCell id="v104" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="740" height="134" as="geometry"/></mxCell><mxCell id="v105" value="&lt;b&gt;Легенда&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1016" width="200" height="20" as="geometry"/></mxCell><mxCell id="v106" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="52" y="1042" width="30" height="16" as="geometry"/></mxCell><mxCell id="v107" value="Сервер копий (ovirt-backup)" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="1039" width="195" height="22" as="geometry"/></mxCell><mxCell id="v108" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="52" y="1066" width="30" height="16" as="geometry"/></mxCell><mxCell id="v109" value="Платформы виртуализации" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="1063" width="195" height="22" as="geometry"/></mxCell><mxCell id="v110" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="292" y="1042" width="30" height="16" as="geometry"/></mxCell><mxCell id="v111" value="Хранилища и данные" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="1039" width="195" height="22" as="geometry"/></mxCell><mxCell id="v112" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#263238;strokeColor=#263238;fontColor=#eceff1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="292" y="1066" width="30" height="16" as="geometry"/></mxCell><mxCell id="v113" value="Формат / файлы" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="1063" width="195" height="22" as="geometry"/></mxCell><mxCell id="v114" value="" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffde7;strokeColor=#b59f3b;fontSize=11;spacing=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="532" y="1042" width="30" height="16" as="geometry"/></mxCell><mxCell id="v115" value="Файл / секрет" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="1039" width="195" height="22" as="geometry"/></mxCell><mxCell id="v116" value="" style="rounded=0;fillColor=#2e7d32;strokeColor=#2e7d32;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="532" y="1073" width="30" height="2" as="geometry"/></mxCell><mxCell id="v117" value="Поток данных копии" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="1063" width="195" height="22" as="geometry"/></mxCell><mxCell id="v118" value="🔒 защита" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="52" y="1090" width="90" height="20" as="geometry"/></mxCell><mxCell id="v119" value="⚠ остаточный риск" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="148" y="1090" width="130" height="20" as="geometry"/></mxCell><mxCell id="v120" value="&lt;i&gt;Слой «Защита» скрывается: Вид → Слои (Ctrl+Shift+L)&lt;/i&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="1114" width="720" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="8. Хранилища, реплики, ретенция, проверка"><mxGraphModel dx="1880" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" value="Схема" parent="0"/><mxCell id="sec" value="Защита" parent="0"/><mxCell id="v1" value="8. Хранилища, вторая копия, ретенция и проверка копий" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1820" height="34" as="geometry"/></mxCell><mxCell id="v2" value="Что происходит с точкой после записи: реплики, очистка по правилам и доказательство, что из копии можно восстановиться. Слой «Защита» — что мешает потерять или незаметно испортить копии." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1820" height="40" as="geometry"/></mxCell><mxCell id="v3" value="Хранилища копий (repo.Backend)" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="600" height="520" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;Локальный каталог&lt;/b&gt;&lt;br&gt;/backups, отдельный диск, NFS" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="220" height="66" as="geometry"/></mxCell><mxCell id="v5" value="🔒 каталог открыт через os.Root: без «..», абсолютных ключей и symlink; путь — только внутри доступных службе точек" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="270" y="155" width="330" height="56" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;S3&lt;/b&gt;&lt;br&gt;MinIO, Ceph RGW, облака" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="220" height="66" as="geometry"/></mxCell><mxCell id="v7" value="🔒 HTTPS · Object Lock (Governance) на N дней для объектов данных; обход блокировки служба не запрашивает" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="270" y="231" width="330" height="56" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;SFTP&lt;/b&gt;&lt;br&gt;сервер по SSH" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="220" height="66" as="geometry"/></mxCell><mxCell id="v9" value="🔒 только ключ; host key закреплён, пустое поле = нет подключения" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="270" y="307" width="330" height="56" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;SMB&lt;/b&gt;&lt;br&gt;NAS, SMB 2/3" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="378" width="220" height="66" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;WebDAV&lt;/b&gt;&lt;br&gt;NAS, облачные диски" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="454" width="220" height="66" as="geometry"/></mxCell><mxCell id="v12" value="🔒 HTTPS; пароль зашифрован secret.key" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="270" y="459" width="330" height="56" as="geometry"/></mxCell><mxCell id="v13" value="⚠ SMB: подпись и шифрование канала задаются политикой NAS — служба их не навязывает" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="270" y="383" width="330" height="56" as="geometry"/></mxCell><mxCell id="v14" value="⚠ S3 Governance снимается правом s3:BypassGovernanceRetention — ключу службы его не давать" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff4e5;strokeColor=#ef6c00;fontColor=#7a3e00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="40" y="530" width="560" height="30" as="geometry"/></mxCell><mxCell id="v15" value="🔒 проверка хранилищ каждые 15 мин: запись, чтение, удаление пробного объекта; для S3 — конфигурация Object Lock" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="40" y="566" width="560" height="44" as="geometry"/></mxCell><mxCell id="v16" value="Вторая копия: storage_mode задания" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=#fbfbfb;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#546e7a;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="1220" height="520" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;copy&lt;/b&gt; — копирование из основного" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a2b3c;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="150" width="380" height="26" as="geometry"/></mxCell><mxCell id="v18" value="диск ВМ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="660" y="190" width="100" height="50" as="geometry"/></mxCell><mxCell id="v19" value="служба" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="190" width="90" height="50" as="geometry"/></mxCe