#!/usr/bin/env bash
set -Eeuo pipefail

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

fail() {
  printf 'jhvirt-pve-data-plane: %s\n' "$*" >&2
  exit 64
}

# With a forced command in authorized_keys sshd starts this helper without the
# requested arguments and puts the request into SSH_ORIGINAL_COMMAND. Parse it
# as words only after accepting the exact, space-free protocol alphabet.
if [[ $# -eq 0 && -n "${SSH_ORIGINAL_COMMAND:-}" ]]; then
  [[ "$SSH_ORIGINAL_COMMAND" =~ ^(/usr/local/sbin/)?jhvirt-pve-data-plane(\ [A-Za-z0-9_./+=-]+)+$ ]] || fail "invalid forced command"
  IFS=' ' read -r -a original <<< "$SSH_ORIGINAL_COMMAND"
  [[ "${original[0]}" == "jhvirt-pve-data-plane" || "${original[0]}" == "/usr/local/sbin/jhvirt-pve-data-plane" ]] || fail "invalid helper path"
  set -- "${original[@]:1}"
fi

[[ ${EUID} -eq 0 ]] || fail "the helper must run as root"

action="${1:-}"
case "$action" in
  probe)
    [[ $# -eq 1 ]] || fail "probe takes no arguments"
    command -v vzdump >/dev/null
    command -v qmrestore >/dev/null
    command -v pct >/dev/null
    printf 'jhvirt-pve-data-plane/1\n'
    ;;

  backup)
    [[ $# -eq 3 ]] || fail "usage: backup qemu|lxc VMID"
    kind="$2"; vmid="$3"
    [[ "$kind" == qemu || "$kind" == lxc ]] || fail "invalid guest kind"
    [[ "$vmid" =~ ^[1-9][0-9]{2,8}$ ]] || fail "invalid VMID"
    # --stdout is the supported Proxmox CLI data path. The REST endpoint rejects
    # this option, which is why this narrowly scoped SSH helper exists.
    exec vzdump "$vmid" --stdout --mode snapshot --compress zstd --quiet 1
    ;;

  restore)
    [[ $# -eq 7 ]] || fail "usage: restore KIND VMID STORAGE NETWORK START NAME_B64"
    kind="$2"; vmid="$3"; storage="$4"; network="$5"; start="$6"; name64="$7"
    [[ "$kind" == qemu || "$kind" == lxc ]] || fail "invalid guest kind"
    [[ "$vmid" =~ ^[1-9][0-9]{2,8}$ ]] || fail "invalid VMID"
    [[ "$storage" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || fail "invalid storage id"
    [[ "$network" == detached || "$network" == attached ]] || fail "invalid network mode"
    [[ "$start" == 0 || "$start" == 1 ]] || fail "invalid start flag"
    [[ "$name64" =~ ^[A-Za-z0-9+/=]+$ ]] || fail "invalid encoded name"
    name="$(printf %s "$name64" | base64 -d)" || fail "invalid encoded name"
    [[ -n "$name" && ${#name} -le 255 && "$name" != *$'\n'* && "$name" != *$'\r'* ]] || fail "invalid guest name"

    created=0
    cleanup() {
      [[ "$created" == 1 ]] || return 0
      if [[ "$kind" == qemu ]]; then
        qm stop "$vmid" --skiplock 1 >/dev/null 2>&1 || true
        qm destroy "$vmid" --purge 1 --destroy-unreferenced-disks 1 >/dev/null 2>&1 || true
      else
        pct stop "$vmid" --skiplock 1 >/dev/null 2>&1 || true
        pct destroy "$vmid" --purge 1 --destroy-unreferenced-disks 1 >/dev/null 2>&1 || true
      fi
    }
    trap cleanup ERR HUP INT TERM

    if [[ "$kind" == qemu ]]; then
      qmrestore - "$vmid" --storage "$storage" --unique 1 --start 0
      created=1
      qm set "$vmid" --name "$name" >/dev/null
    else
      # Omitting --rootfs keeps Proxmox in simple restore mode. In that mode it
      # recreates every volume-backed mp0..mpN from the archive on --storage;
      # specifying --rootfs would switch to advanced mode and silently ignore
      # mount points we did not repeat on the command line.
      pct restore "$vmid" - --storage "$storage" --unique 1
      created=1
      pct set "$vmid" --hostname "$name" >/dev/null
    fi

    if [[ "$network" == detached ]]; then
      tool=qm
      [[ "$kind" == lxc ]] && tool=pct
      while IFS=: read -r key value; do
        key="${key//[[:space:]]/}"
        [[ "$key" =~ ^net[0-9]+$ ]] || continue
        value="${value# }"
        if [[ ",$value," =~ ,link_down=[^,]*, ]]; then
          value="$(printf %s "$value" | sed -E 's/(^|,)link_down=[^,]*/\1link_down=1/')"
        else
          value="${value},link_down=1"
        fi
        "$tool" set "$vmid" "--$key" "$value" >/dev/null
      done < <("$tool" config "$vmid")
    fi

    if [[ "$start" == 1 ]]; then
      [[ "$network" == attached ]] || fail "a detached guest cannot be started automatically"
      if [[ "$kind" == qemu ]]; then qm start "$vmid"; else pct start "$vmid"; fi
    fi
    created=0
    trap - ERR HUP INT TERM
    ;;

  *) fail "unknown action" ;;
esac
