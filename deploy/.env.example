# Боевая конфигурация ovirt-backup.
#
# Это справочник по переменным, а не готовый файл. Готовит .env и защищённые
# файлы секретов в Docker volumes установщик — он же создаёт отдельные роли
# PostgreSQL для приложения и Keycloak:
#
#   ./install.sh
#
# Не запускайте Compose простым копированием этого файла: одного .env больше
# недостаточно. Это намеренно не позволяет вернуть пароли БД и OIDC в
# environment, где они видны через `docker inspect`.

# --- Имя проекта -------------------------------------------------------------
# От него зависят имена томов и контейнеров. Задаётся здесь, а не ключом name:
# в compose-файле, потому что этот ключ понимают не все реализации.
COMPOSE_PROJECT_NAME=ovirt-backup

# --- СУБД -------------------------------------------------------------------
# POSTGRES_USER — административная роль только для обслуживания встроенной
# БД. Приложение подключается отдельной ролью POSTGRES_APP_USER, её пароль
# лежит в `/app/data/database.password` с правами 0600.
POSTGRES_USER=jhvirt
POSTGRES_APP_USER=ovirt_backup_app
POSTGRES_DB=jhvirt

# --- Адрес ------------------------------------------------------------------
# По нему интерфейс открывают в браузере. https здесь включает флаг Secure у
# куки сессии — даже когда TLS терминирует обратный прокси, а сервис слушает
# http. Обязателен именно поэтому.
# Схема должна совпадать с адресом браузера. Не ставьте https заранее: Secure
# cookie не работает при фактическом доступе по обычному http.
JHV_EXTERNAL_URL=https://virt.example.org

# Порт наружу. За обратным прокси разумно оставить 127.0.0.1:8080:8080,
# чтобы сервис не смотрел в сеть напрямую.
JHV_PORT=8080
# Ограничить публикацию loopback-адресом при работе за reverse proxy:
# JHV_BIND_ADDRESS=127.0.0.1

# Собственный TLS приложения. Установщик заполняет эти поля при выборе
# --tls self-signed или --tls files. Сертификат и ключ находятся в защищённом
# томе jhvirt-data; при TLS на reverse proxy оставьте false.
JHV_TLS_ENABLED=false
JHV_TLS_CERT_FILE=/app/data/tls/server.crt
JHV_TLS_KEY_FILE=/app/data/tls/server.key

# --- Учётная запись ---------------------------------------------------------
# Новая установка создаёт локальную аварийную запись local-admin. Её
# одноразовый пароль установщик кладёт в защищённый файл, удаляет после
# успешного старта и выводит оператору один раз.
JHV_AUTH_BOOTSTRAP_USER=local-admin
# JHV_ADMIN_PASSWORD_FILE=/app/data/bootstrap-admin.password
# SHA-256 host-only recovery.token. Заполняется установщиком; сам токен в
# Compose и рабочий контейнер не передаётся.
JHV_RECOVERY_TOKEN_HASH=

# --- Вход через Keycloak (или другой OIDC-провайдер) -------------------------
# Пароль пользователя служба при таком входе не видит вовсе: его вместе со
# вторым фактором проверяет провайдер. Двухфакторная проверка (FreeOTP и
# совместимые), единый вход и мгновенный отзыв доступа настраиваются в realm
# провайдера, а не здесь.
#
# Несколько доменов подключаются на стороне Keycloak — User Federation на
# каждый каталог внутри одного realm. Службе он отдаёт один issuer, и второй
# провайдер ей не нужен.
JHV_OIDC_ENABLED=false
JHV_OIDC_ISSUER=https://keycloak.example.org/realms/infra
# Необязательный внутренний origin для приложения. У встроенного Keycloak:
# http://keycloak:8080. Публичный issuer при этом не меняется.
JHV_OIDC_BACKCHANNEL_URL=
JHV_OIDC_CLIENT_ID=jhvirt
# Секрет создаёт установщик в томе jhvirt-data с правами 0600.
# JHV_OIDC_CLIENT_SECRET_FILE=/app/data/oidc-client.secret
# Провайдер сверяет его побуквенно; должен совпадать с внешним адресом выше.
JHV_OIDC_REDIRECT_URL=https://virt.example.org/api/v1/auth/oidc/callback
# Надпись на кнопке страницы входа. Пусто — «Войти через провайдера».
JHV_OIDC_BUTTON_LABEL=Войти через Keycloak
# Где в токене лежат группы. Для Keycloak нужен mapper типа Group Membership
# с Full group path: Off, иначе группы приедут как /virt-admins.
JHV_OIDC_GROUPS_CLAIM=groups
# Пусто — тот, чьи группы ни во что не отобразились, в систему не допускается.
JHV_OIDC_DEFAULT_ROLE=
# Куда провайдер вернёт браузер после выхода. Должен быть в списке разрешённых
# у провайдера (в Keycloak — Valid post logout redirect URIs).
JHV_OIDC_POST_LOGOUT_URL=
# Срок внешней сессии. Короче общего намеренно: роль пересчитывается при входе,
# и столько же живут права, отобранные в каталоге.
JHV_OIDC_SESSION_TTL=1h
# Вход по локальному паролю обходит политики Keycloak и MFA. Безопасное
# значение для обычной работы — false. Значение true используют только для
# заранее описанной аварийной процедуры с отдельным контролем пароля.
JHV_OIDC_ALLOW_LOCAL_LOGIN=false

# Соответствие групп ролям (auth.oidc.role_mapping) переменной окружения не
# задаётся — это словарь. Оно живёт в файле настроек, который монтируется в
# контейнер; по умолчанию берётся config/ovirt-backup.yaml из репозитория.
# Установщик при настройке внешнего входа кладёт готовый файл рядом с
# compose и прописывает его сюда:
# JHV_CONFIG_FILE=./ovirt-backup.yaml

# --- Свой Keycloak рядом ------------------------------------------------------
# Заполняется установщиком при `./install.sh --oidc keycloak`. Вручную нужно
# только COMPOSE_PROFILES: без него служба Keycloak не поднимается вовсе, и
# установка работает как обычно, с входом по паролю.
# COMPOSE_PROFILES=keycloak
# Адрес, по которому Keycloak виден браузеру; он же попадает в issuer токенов.
# JHV_KEYCLOAK_URL=https://virt.example.org:8081
# KEYCLOAK_PORT=8081
# База Keycloak в том же кластере PostgreSQL; создаётся установщиком.
# KEYCLOAK_DB=keycloak
# Временная учётная запись bootstrap-администратора Keycloak называется
# kc-bootstrap-admin. Пароль живёт в защищённом keycloak.conf только до
# создания realm и удаляется установщиком после успешной настройки.
# KEYCLOAK_ADMIN_USER=kc-bootstrap-admin
# Базовый образ закреплён не только тегом, но и digest. Менять после проверки:
# KEYCLOAK_BASE_IMAGE=quay.io/keycloak/keycloak:26.7.2@sha256:...
# KEYCLOAK_VERSION=26.7.2
# Официальный PostgreSQL служит закреплённой основой. Compose собирает поверх
# него локальный ovirt-backup-postgres и выполняет apk upgrade, поэтому
# исправления Alpine применяются даже до публикации нового digest PostgreSQL.
# POSTGRES_IMAGE=docker.io/library/postgres:17-alpine@sha256:...
# POSTGRES_VERSION=17-alpine-hardened

# Ограничения ресурсов контейнеров. Это верхние пределы, а не резервирование.
# JHV_MEMORY_LIMIT=4g
# JHV_CPU_LIMIT=4.0
# JHV_PIDS_LIMIT=512
# POSTGRES_MEMORY_LIMIT=2g
# POSTGRES_CPU_LIMIT=2.0
# KEYCLOAK_MEMORY_LIMIT=2g
# KEYCLOAK_CPU_LIMIT=2.0

# --- Аварийная копия собственной БД -----------------------------------------
# install.sh создаёт два ежедневных custom-format dump: БД приложения и, при
# профиле keycloak, БД Keycloak. Вместе с dump приложения копируется secret.key.
# Каталог на системном диске защищает от потери volume, но не от потери узла:
# в production укажите отдельный mount или регулярно забирайте его на другой
# сервер. Файлы публикуются только после pg_restore --list и имеют режим 0600.
# JHV_DR_BACKUP_DIR=/mnt/dr/ovirt-backup
# JHV_DR_KEEP_DAYS=7
# JHV_DR_INTERVAL_SECONDS=86400
# JHV_DR_DUMP_MAX_AGE=36h

# --- Каталоги ---------------------------------------------------------------
# Локальное хранилище копий. Смонтируйте сюда NFS-шару или отдельный том.
JHV_BACKUP_DIR=/srv/backups
# Куда складывать восстановленные образы. Отдельно от копий: восстановление не
# должно съедать место под сами копии.
JHV_RESTORE_DIR=/srv/restores

# --- Необязательное ---------------------------------------------------------
# Версия в теге образа — чтобы потом было видно, что развёрнуто.
VERSION=1.0.0
TZ=UTC

# Файл журнала внутри контейнера. По умолчанию /app/data/logs/jhvirt.log — в
# томе, поэтому история переживает пересоздание контейнера, а интерфейс может
# показать журнал (потока docker logs он не видит, ему нужен файл).
#
# Путь обязан быть внутри /app/data. Всё остальное в контейнере доступно
# только для чтения, а каталог /app/logs вдобавок лежит в слое и исчезает при
# каждом пересоздании.
# JHV_LOG_FILE=/app/data/logs/jhvirt.log

# Режим TLS до PostgreSQL: disable|prefer|require|verify-ca|verify-full.
# По умолчанию prefer. Для базы в сети контейнеров этого достаточно — трафик
# наружу не выходит. Вынесли базу на отдельную машину — поднимите до require
# или verify-full; со значением disable служба туда просто не подключится.
# JHV_DATABASE_SSLMODE=prefer

# Дополнительные каталоги восстановления (через запятую). Каждый должен быть
# смонтирован в контейнер.
# JHV_RESTORE_DIRS=/restores,/mnt/restore

# Адреса, которым разрешены межсайтовые запросы к API. Заполнять только если
# интерфейс раздаётся не этим же процессом.
# JHV_CORS_ORIGINS=https://other.example.org
