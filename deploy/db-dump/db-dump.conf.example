# /etc/jhvirt/db-dump.conf — настройки хелпера jhvirt-db-dump.
#
# Файл выполняется хелпером как shell-код, поэтому хелпер откажется работать,
# если он не принадлежит root или доступен на запись группе и другим.
# Права: root:root 0644.

# Восстановление в НОВУЮ базу по запросу службы. Выключено по умолчанию:
# роли хелпера для него нужно право создавать базы (PostgreSQL: CREATEDB).
# Существующая база не перезаписывается в любом случае.
JHVIRT_DB_ALLOW_RESTORE=0

# PostgreSQL: каталог сокета и порт, если не стандартные; база для служебных
# запросов (список баз, версия).
#JHVIRT_PG_HOST=/var/run/postgresql
#JHVIRT_PG_PORT=5432
#JHVIRT_PG_MAINTENANCE_DB=postgres

# MySQL / MariaDB: файл параметров клиента, если вход через сокет без пароля
# невозможен. Файл — владелец пользователь хелпера, права 0600.
#JHVIRT_MYSQL_DEFAULTS_FILE=/home/jhvirt_dump/.my.cnf

# Базы, которые не попадают в список «все базы» (через пробел).
#JHVIRT_DB_EXCLUDE="scratch tmp_reports"
