{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["externalURL", "database", "appSecret"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "externalURL": { "type": "string", "pattern": "^https?://[^/]+(/.*)?$" },
    "database": {
      "type": "object",
      "required": ["existingSecret", "urlKey"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "urlKey": { "type": "string", "minLength": 1 }
      }
    },
    "appSecret": {
      "type": "object",
      "required": ["existingSecret", "keyKey"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "keyKey": { "type": "string", "minLength": 1 }
      }
    }
  }
}

