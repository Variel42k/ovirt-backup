mxCell><mxCell id="a28" value="вход сервисной записью → CheckAccess:&lt;br&gt;кластеры, ВМ, диски, домены хранения" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="680" as="sourcePoint"/><mxPoint x="660" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v29" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="652" width="26" height="26" as="geometry"/></mxCell><mxCell id="v30" value="🔒 доступ проверяется под новой записью — «роль создалась» не выдаётся за «бэкап заработает»" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fdecea;strokeColor=#c62828;fontColor=#7f0000;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="sec"><mxGeometry x="1060" y="650" width="380" height="30" as="geometry"/></mxCell><mxCell id="a31" value="" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#37474f;fontSize=11;fontColor=#263238;labelBackgroundColor=#ffffff;align=center;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="708" as="sourcePoint"/><mxPoint x="390" y="726" as="targetPoint"/><Array as="points"><mxPoint x="424" y="708"/><mxPoint x="424" y="726"/></Array></mxGeometry></mxCell><mxCell id="v32" value="сохранить подключение с сервисной записью;&lt;br&gt;пароль администратора забыт" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontFamily=Helvetica;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="702" width="250" height="36" as="geometry"/></mxCell><mxCell id="v33" value="11" style="ellipse;whit